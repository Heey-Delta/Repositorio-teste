---
// Experimental Lab: página inicial em forma de feed.
// Ordem: título, imagem, busca e categorias > Publicado hoje (3 e meio) > Volumes (o caminho principal, cards
// maiores, 40/40/20) > Top hypados (as mais curtidas, 3 e 1/3) > Este mês > Todas (lista que carrega sozinha).
// Renderizada no servidor e guardada na CDN por 2 minutos: "hoje", "este mês" e as curtidas ficam sempre em dia,
// sem um novo deploy. Imagens fora da tela só carregam quando chegam perto (loading="lazy").
import '../../styles/lab-feed.css';
import Lab from '../../layouts/Lab.astro';
import LabIcon from '../../components/lab/LabIcon.astro';
import Rail from '../../components/lab/Rail.astro';
import FeedCard from '../../components/lab/FeedCard.astro';
import VolumeCard from '../../components/lab/VolumeCard.astro';
import { getCatalogPublic } from '../../lib/lab-public';
import { liveCards, publishedVolumes, topLiked, isToday, isThisMonth } from '../../lib/lab-feed';
import { LAB_NAME, LAB_DESCRIPTION } from '../../lab/data';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=120, stale-while-revalidate=600');

const hasDb = Boolean(process.env.DATABASE_URL);
const [{ departments }, all, volumes] = await Promise.all([
  getCatalogPublic(),
  hasDb ? liveCards() : Promise.resolve([]),
  hasDb ? publishedVolumes() : Promise.resolve([]),
]);
const PAGE = 12;
const now = new Date();
const hype = topLiked(all, 12);
const today = all.filter((c) => isToday(c.date, now));
const month = all.filter((c) => !isToday(c.date, now) && isThisMonth(c.date, now));
const first = all.slice(0, PAGE);
const perDept = (slug: string) => all.filter((c) => c.dept === slug).length;
const monthName = now.toLocaleDateString('pt-BR', { month: 'long', timeZone: 'America/Sao_Paulo' });
const todayName = now.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', timeZone: 'America/Sao_Paulo' });

const personId = new URL('/#hallan', Astro.site).href;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: LAB_NAME, description: LAB_DESCRIPTION,
  url: new URL('/lab/', Astro.site).href, inLanguage: 'pt-BR',
  isPartOf: { '@type': 'WebSite', name: 'Hallan', url: new URL('/', Astro.site).href, publisher: { '@id': personId } },
  author: { '@id': personId },
  ...(volumes.length ? { hasPart: volumes.map((v) => ({ '@type': 'CollectionPage', name: v.title, url: new URL(v.url, Astro.site).href })) } : {}),
  ...(all.length ? { mainEntity: { '@type': 'ItemList', itemListElement: all.slice(0, 20).map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(c.url, Astro.site).href, name: c.title })) } } : {}),
}];
---
<Lab title="Experimentos, ensaios e pesquisas" description={LAB_DESCRIPTION} depth={1} noindex={!all.length} jsonld={jsonld}>
  <!-- TOPO: título, imagem do laboratório, busca e categorias (gerais; o caminho principal são os volumes) -->
  <section class="lf-top" aria-labelledby="lab-title">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-6 py-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-12 lg:py-12">
      <div class="flex min-w-0 flex-col gap-5 lg:gap-6">
        <h1 id="lab-title" class="lf-title">/Experimental <span class="text-accent">Lab</span></h1>
        <p class="m-0 max-w-[460px] text-[15px] text-muted lg:text-base">Experimentos, ensaios e pesquisas sobre design, tecnologia e percepção. Os volumes reúnem os textos por assunto, na ordem de leitura.</p>
        <button type="button" class="lf-search" data-open-search aria-controls="labSearch">
          <LabIcon name="search" class="size-5 shrink-0" />
          <span>Buscar por assunto, título ou #tag</span>
          <kbd aria-hidden="true">/</kbd>
        </button>
        <nav aria-label="Categorias do laboratório">
          <ul class="lf-cats">
            {departments.map((d) => (
              <li><a href={`/lab/${d.slug}/`} class="lf-cat"><LabIcon name={d.icon} class="size-4" />{d.name}<small>{perDept(d.slug)}</small></a></li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="lf-hero-img order-first lg:order-none">
        <img src="/img/laboratorio.webp" alt="Cúpula escura sobre uma cidade em ruínas, em meio-tom preto e branco" width="1200" height="750" fetchpriority="high" decoding="async">
      </div>
    </div>
  </section>

  {!all.length && (
    <section class="lf-sec">
      <div class="wrap flex flex-col items-start gap-3">
        <h2 class="lf-h2">/Em breve</h2>
        <p class="m-0 max-w-[480px] text-[15px] text-muted">Os primeiros experimentos e notas estão sendo escritos. Enquanto isso, veja os trabalhos no portfólio.</p>
        <a href="/#works" class="lf-more">Ver os trabalhos</a>
      </div>
    </section>
  )}

  <!-- PUBLICADO HOJE (acima dos volumes): três e meio por tela -->
  {today.length > 0 && (
    <section class="lf-sec" aria-labelledby="today-title">
      <div class="wrap">
        <div class="lf-head">
          <div><h2 id="today-title" class="lf-h2 lf-h2--sm">/Publicado hoje</h2><p class="lf-sub">{todayName}</p></div>
        </div>
        <Rail size="today" label="Publicado hoje" loop={today.length > 3}>
          {today.map((c, i) => <li class="rail-item"><FeedCard c={c} eager={i < 3} /></li>)}
        </Rail>
      </div>
    </section>
  )}

  <!-- VOLUMES: coletâneas escolhidas a dedo (os cards maiores da página) -->
  {volumes.length > 0 && (
    <section class="lf-sec" aria-labelledby="vol-title">
      <div class="wrap">
        <div class="lf-head">
          <div><h2 id="vol-title" class="lf-h2">/Volumes</h2><p class="lf-sub">Textos reunidos por assunto, na ordem de leitura.</p></div>
          <a href="/lab/volumes/" class="lf-more">Ver todos</a>
        </div>
        <Rail size="vol" label="Volumes" loop={volumes.length > 2}>
          {volumes.map((v, i) => <li class="rail-item"><VolumeCard v={v} eager={i < 2 && !today.length} /></li>)}
        </Rail>
      </div>
    </section>
  )}

  <!-- TOP HYPADOS: as publicações mais curtidas, na ordem do ranking -->
  {hype.length > 0 && (
    <section class="lf-sec" aria-labelledby="hype-title">
      <div class="wrap">
        <div class="lf-head">
          <div><h2 id="hype-title" class="lf-h2 lf-h2--sm">/Top hypados</h2><p class="lf-sub">As mais curtidas.</p></div>
        </div>
        <Rail size="card" label="Top hypados" loop={hype.length > 3}>
          {hype.map((c, i) => <li class="rail-item"><FeedCard c={c} variant="hype" rank={i + 1} /></li>)}
        </Rail>
      </div>
    </section>
  )}

  <!-- ESTE MÊS -->
  {month.length > 0 && (
    <section class="lf-sec" aria-labelledby="month-title">
      <div class="wrap">
        <div class="lf-head">
          <div><h2 id="month-title" class="lf-h2 lf-h2--sm">/Este mês</h2><p class="lf-sub">{monthName[0].toUpperCase() + monthName.slice(1)}, sem as de hoje.</p></div>
        </div>
        <Rail size="card" label="Publicado este mês" loop={month.length > 3}>
          {month.map((c) => <li class="rail-item"><FeedCard c={c} /></li>)}
        </Rail>
      </div>
    </section>
  )}

  <!-- TODAS: da mais recente para a mais antiga; o resto carrega ao chegar no fim -->
  {all.length > 0 && (
    <section class="lf-sec" aria-labelledby="all-title">
      <div class="wrap">
        <div class="lf-head">
          <div><h2 id="all-title" class="lf-h2 lf-h2--sm">/Todas as publicações</h2><p class="lf-sub">{all.length} {all.length === 1 ? 'publicação' : 'publicações'}, da mais nova para a mais antiga.</p></div>
          <a href="/lab/rss.xml" class="lf-more">RSS</a>
        </div>
        <ul class="lf-list" id="feedList" aria-live="polite">
          {first.map((c) => <FeedCard c={c} variant="row" />)}
        </ul>
        {all.length > PAGE && (
          <div class="lf-load" id="feedMore" data-next={PAGE}>
            <button type="button">Carregar mais</button>
          </div>
        )}
      </div>
    </section>
  )}

  <script is:inline>
    (function () {
      // ---------- carrosséis: setas no computador e volta ao começo no fim (infinito) ----------
      document.querySelectorAll('[data-rail]').forEach(function (rail) {
        var track = rail.querySelector('.rail-track');
        var items = Array.prototype.slice.call(track.children);
        if (!items.length) return;
        var loop = rail.hasAttribute('data-loop') && track.scrollWidth > track.clientWidth + 8;
        var setWidth = 0;
        if (loop) {
          // cópias antes e depois (escondidas do leitor de tela e do teclado); a rolagem fica sempre na do meio
          var mk = function (n) { var c = n.cloneNode(true); c.setAttribute('aria-hidden', 'true'); c.setAttribute('inert', ''); c.dataset.clone = '1'; c.querySelectorAll('img').forEach(function (i) { i.loading = 'lazy'; }); return c; };
          var before = items.map(mk), after = items.map(mk);
          before.forEach(function (c) { track.insertBefore(c, items[0]); });
          after.forEach(function (c) { track.appendChild(c); });
          var measure = function () { setWidth = items[0].offsetLeft - before[0].offsetLeft; };
          measure();
          track.style.scrollSnapType = 'none'; track.scrollLeft = setWidth; track.style.scrollSnapType = '';
          var t;
          var wrap = function () {
            if (track.scrollLeft < setWidth * 0.5) jump(setWidth);
            else if (track.scrollLeft > setWidth * 1.5) jump(-setWidth);
          };
          var jump = function (d) { track.style.scrollSnapType = 'none'; track.scrollLeft += d; track.style.scrollSnapType = ''; };
          track.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(wrap, 120); }, { passive: true });
          // girar a tela ou redimensionar: volta para o mesmo card (as larguras mudam junto com a janela)
          var at = 0;
          track.addEventListener('scroll', function () { var w = items[0].getBoundingClientRect().width; if (w) at = Math.round((track.scrollLeft - setWidth) / (items[1] ? items[1].offsetLeft - items[0].offsetLeft : w)); }, { passive: true });
          window.addEventListener('resize', function () { measure(); var unit = items[1] ? items[1].offsetLeft - items[0].offsetLeft : items[0].offsetWidth; jump(setWidth + at * unit - track.scrollLeft); });
        }
        var step = function () { return items[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '12'); };
        rail.querySelectorAll('.rail-nav').forEach(function (b) {
          b.addEventListener('click', function () { track.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' }); });
        });
        if (track.scrollWidth > track.clientWidth + 8) rail.setAttribute('data-ready', '');
      });

      // ---------- busca: o campo do topo abre a busca do cabeçalho ("/" é tratado no layout) ----------
      var openSearch = function () { var b = document.getElementById('labSearchBtn'); if (b && b.getAttribute('aria-expanded') !== 'true') b.click(); else { var i = document.getElementById('labSearchInput'); if (i) i.focus(); } };
      document.querySelectorAll('[data-open-search]').forEach(function (b) { b.addEventListener('click', openSearch); });

      // ---------- lista infinita: carrega ao chegar perto do fim (ou pelo botão) ----------
      var more = document.getElementById('feedMore'), list = document.getElementById('feedList');
      if (!more || !list) return;
      var busy = false;
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var fmt = function (iso) { return new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Sao_Paulo' }).replace(/\./g, ''); };
      var heart = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.7 3.9 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.4 0 5.7 3.2 4.5 6.6-1.7 4.8-9.2 9.4-9.2 9.4z"/></svg>';
      var row = function (c) {
        return '<li class="row"><div class="row-media">' + (c.cover ? '<img src="' + esc(c.cover.url) + '" alt="" loading="lazy" decoding="async">' : '') + '</div>'
          + '<div class="min-w-0"><h3 class="row-title"><a href="' + esc(c.url) + '" class="pc-link">' + esc(c.title) + '</a></h3>'
          + (c.summary ? '<p class="row-sum">' + esc(c.summary) + '</p>' : '')
          + '<p class="row-meta">' + esc(c.deptName) + ' · <time datetime="' + esc(c.date) + '">' + fmt(c.date) + '</time></p></div>'
          + '<button type="button" class="like" data-like="' + esc(c.id) + '" aria-pressed="false" aria-label="Curtir: ' + c.likes + '">' + heart + '<span data-like-count>' + c.likes + '</span></button></li>';
      };
      var load = function () {
        if (busy || !more.dataset.next) return;
        busy = true; var bt = more.querySelector('button'); bt.textContent = 'Carregando'; bt.setAttribute('aria-busy', 'true');
        fetch('/api/lab/lista?offset=' + more.dataset.next + '&limit=12').then(function (r) { return r.json(); }).then(function (d) {
          list.insertAdjacentHTML('beforeend', d.items.map(row).join(''));
          if (window.labLikes) window.labLikes.sync(d.items.map(function (c) { return c.id; }));
          if (d.next == null) { more.remove(); io && io.disconnect(); } else { more.dataset.next = d.next; more.querySelector('button').textContent = 'Carregar mais'; }
        }).catch(function () { more.querySelector('button').textContent = 'Não carregou. Tentar de novo'; }).finally(function () { busy = false; var b2 = more.querySelector('button'); if (b2) b2.removeAttribute('aria-busy'); });
      };
      more.querySelector('button').addEventListener('click', load);
      var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) { if (es[0].isIntersecting) load(); }, { rootMargin: '600px 0px' }) : null;
      if (io) io.observe(more);
    })();
  </script>
</Lab>
