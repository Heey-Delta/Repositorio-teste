---
// Página de um volume: capa, número, título, descrição e os artigos na ordem escolhida.
// Artigos agendados aparecem como "em breve" (com a data), sem link: fica claro o que já dá para ler.
// Indexável, com dados estruturados (CollectionPage + lista ordenada dos artigos).
import '../../../styles/lab-feed.css';
import Lab from '../../../layouts/Lab.astro';
import FeedCard from '../../../components/lab/FeedCard.astro';
import { publishedVolumes } from '../../../lib/lab-feed';
import { getLabEntriesFresh, dataSlugOf } from '../../../lib/lab-public';
import { dataItems, KIND_LABEL } from '../../../lib/data-items';
import { countWords, fmtWords } from '../../../lab/data';
import Bolt from '../../../components/lab/Bolt.astro';

export const prerender = false;
const [v] = process.env.DATABASE_URL ? await publishedVolumes(Astro.params.slug) : [];
if (!v) return new Response(null, { status: 404, statusText: 'Volume não encontrado' });
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=900');
const open = v.posts.filter((p) => !p.soon), soon = v.posts.filter((p) => p.soon);
// fontes e dados de todos os artigos do volume (abre num botão, em lista): páginas de dados e referências citadas
const entries = await getLabEntriesFresh();
const sources = open.map((p) => {
  const e = entries.find((x) => x.postId === p.id);
  if (!e) return null;
  const items = dataItems(e.body);
  return { title: p.title, url: p.url, data: items.map((it) => ({ label: `${KIND_LABEL[it.kind]}: ${it.name}`, url: `/dados/${dataSlugOf(e, entries)}/${it.slug}/` })), refs: e.data.references };
}).filter((x): x is NonNullable<typeof x> => Boolean(x && (x.data.length || x.refs.length)));
// total de palavras de todos os artigos já no ar (o mesmo cálculo do "17,5k words" de cada artigo)
const words = open.reduce((n, p) => { const e = entries.find((x) => x.postId === p.id); return n + (e ? countWords(e.body) : 0); }, 0);
const nData = sources.reduce((n, x) => n + x.data.length, 0), nRefs = sources.reduce((n, x) => n + x.refs.length, 0);
const url = new URL(v.url, Astro.site).href;
const description = v.summary || `Volume ${v.number} do Experimental Lab: ${open.length} ${open.length === 1 ? 'artigo' : 'artigos'} sobre ${v.title.toLowerCase()}.`;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url, url, name: v.title, headline: `Vol. ${v.number}: ${v.title}`,
  description, inLanguage: 'pt-BR', dateModified: v.updated,
  isPartOf: { '@type': 'CollectionPage', name: 'Experimental Lab', url: new URL('/lab/', Astro.site).href },
  author: { '@id': new URL('/#hallan', Astro.site).href },
  ...(v.cover ? { image: new URL(v.cover.url, Astro.site).href } : {}),
  mainEntity: { '@type': 'ItemList', numberOfItems: open.length, itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: open.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(p.url, Astro.site).href, name: p.title })) },
}];
---
<Lab title={`Vol. ${v.number}: ${v.title}`} description={description} depth={3} crumbs={[{ name: 'Volumes', path: '/lab/volumes/' }, { name: v.title, path: v.url }]} jsonld={jsonld} ogImage={v.cover ? { url: new URL(v.cover.url, Astro.site).href, alt: v.cover.alt || v.title } : null}>
  <section class="lf-sec">
    <div class="wrap grid gap-8 lg:grid-cols-[minmax(0,420px)_1fr] lg:items-end lg:gap-14">
      <div class="vol w-full max-w-[320px] lg:max-w-none" style="padding:10px">
        <span class="vol-cover" style="aspect-ratio:3/4">{v.cover && <img src={v.cover.url} alt={v.cover.alt} loading="eager" fetchpriority="high" decoding="async" style="filter:none">}</span>
      </div>
      <div class="flex flex-col gap-4">
        <p class="m-0 flex flex-wrap items-center gap-x-2 text-sm text-muted tabular-nums">Vol. {String(v.number).padStart(2, '0')} · {open.length} {open.length === 1 ? 'artigo' : 'artigos'}{soon.length ? ` · ${soon.length} em breve` : ''} • {fmtWords(words)} · <Bolt n={v.likes} label={`${v.likes} ${v.likes === 1 ? 'curtida' : 'curtidas'} no volume`} /></p>
        <h1 class="lf-title" style="font-size:clamp(40px,9vw,96px)">{v.title}</h1>
        {v.summary && <p class="m-0 max-w-[620px] text-base text-muted lg:text-lg">{v.summary}</p>}
        <div class="flex flex-wrap gap-3">
          {v.experienceUrl && <a href={v.experienceUrl} class="label-ui inline-flex min-h-12 items-center rounded-full bg-accent px-6 text-xs font-bold text-black hover:brightness-110" {...(/^https?:/.test(v.experienceUrl) ? { target: '_blank', rel: 'noopener' } : {})}>{v.experienceLabel || 'Abrir a experiência'}</a>}
          {open[0] && <a href={open[0].url} class:list={['label-ui inline-flex min-h-12 items-center rounded-full px-6 text-xs font-bold', v.experienceUrl ? 'border border-ink text-ink hover:border-accent hover:text-accent' : 'bg-accent text-black hover:brightness-110']}>Começar a ler</a>}
        </div>
      </div>
    </div>
  </section>
  <section class="lf-sec" aria-labelledby="vol-list">
    <div class="wrap">
      <h2 id="vol-list" class="lf-h2 lf-h2--sm" style="margin-bottom:18px">/Neste volume</h2>
      <ol class="lf-list" style="counter-reset:cap">
        {v.posts.map((p) => p.soon
          ? <li class="row" style="border-style:dashed;opacity:.7"><div class="row-media"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></div><div class="min-w-0"><h3 class="row-title">{p.title}</h3><p class="row-meta">Em breve · {new Date(p.soon).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', timeZone: 'America/Sao_Paulo' })}</p></div><span></span></li>
          : <FeedCard c={p} variant="row" />)}
      </ol>
      {sources.length > 0 && (
        <details class="lf-src" style="margin-top:24px">
          <summary>Fontes e dados do volume <span class="text-muted tabular-nums">{[nRefs ? `${nRefs} ${nRefs === 1 ? 'fonte' : 'fontes'}` : '', nData ? `${nData} ${nData === 1 ? 'dado' : 'dados'}` : ''].filter(Boolean).join(' · ')}</span></summary>
          <div class="lf-src-body">
            {sources.map((x) => (
              <div>
                <h3><a href={x.url}>{x.title}</a></h3>
                <ul>
                  {x.data.map((d) => <li><a href={d.url}>{d.label}</a></li>)}
                  {x.refs.map((r) => <li>{r.url ? <a href={r.url} rel="noopener" target="_blank">{r.title}</a> : r.title}{[r.author, r.publisher, r.publishedOn].filter(Boolean).length > 0 && <span> · {[r.author, r.publisher, r.publishedOn].filter(Boolean).join(', ')}</span>}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </details>
      )}
    </div>
  </section>
</Lab>
