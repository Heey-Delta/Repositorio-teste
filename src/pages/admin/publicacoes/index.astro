---
// Lista de publicações (Content Manager, spec 5.2), com filtro por status. A edição vem na próxima etapa.
import Admin from '../../../layouts/Admin.astro';
import { countsByStatus, listPosts, statusLabel, statusOrder, fmtDateTime, type EditorialStatus } from '../../../lib/admin';
export const prerender = false;
const q = Astro.url.searchParams.get('status');
const status = statusOrder.includes(q as EditorialStatus) ? (q as EditorialStatus) : undefined;
const [counts, posts] = await Promise.all([countsByStatus(), listPosts({ status })]);
const filters: { key?: EditorialStatus; label: string }[] = [{ label: 'Todas' }, ...statusOrder.map((k) => ({ key: k, label: statusLabel[k] }))];
---
<Admin title="Publicações" current="publicacoes">
  <div class="flex flex-col gap-6">
    <nav aria-label="Filtrar por status">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {filters.map((f) => {
          const active = f.key === status;
          return (
            <li>
              <a href={f.key ? `?status=${f.key}` : '?'} aria-current={active ? 'true' : undefined}
                class:list={['inline-flex min-h-9 items-center gap-2 rounded-full border px-4 text-sm', active ? 'border-lime text-lime' : 'border-line hover:border-ink']}>
                {f.label}{f.key && <span class="text-muted tabular-nums">{counts[f.key]}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    {posts.length === 0
      ? <p class="m-0 text-sm text-muted">Nada com esse status.</p>
      : (
        <div class="overflow-x-auto rounded-[8px] border border-line">
          <table class="w-full min-w-[720px] border-collapse text-left text-sm">
            <thead class="text-[12px] text-muted">
              <tr class="border-b border-line">
                <th class="px-4 py-3 font-normal">Código</th><th class="px-4 py-3 font-normal">Título</th>
                <th class="px-4 py-3 font-normal">Departamento</th><th class="px-4 py-3 font-normal">Status</th>
                <th class="px-4 py-3 font-normal">Atualizada</th>
              </tr>
            </thead>
            <tbody>
              {posts.map((p) => (
                <tr class="border-b border-line last:border-b-0 hover:bg-[#0b0b0b]">
                  <td class="px-4 py-3 font-mono text-[12px] text-muted tabular-nums">{p.code ?? '—'}</td>
                  <td class="px-4 py-3">{p.title}</td>
                  <td class="px-4 py-3 text-muted">{p.department}</td>
                  <td class="px-4 py-3">{statusLabel[p.status]}</td>
                  <td class="px-4 py-3 text-muted tabular-nums">{fmtDateTime(p.updatedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
  </div>
</Admin>
