---
// Lista de publicações (Content Manager, spec 5.2), com busca e filtro por status. Cada título abre o editor.
import Admin from '../../../layouts/Admin.astro';
import { countsByStatus, listPosts, statusLabel, statusOrder, fmtDateTime, type EditorialStatus } from '../../../lib/admin';
export const prerender = false;
const rawStatus = Astro.url.searchParams.get('status');
const status = statusOrder.includes(rawStatus as EditorialStatus) ? (rawStatus as EditorialStatus) : undefined;
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100);
const [counts, posts] = await Promise.all([countsByStatus(), listPosts({ status, q })]);
const withQ = (base: string) => (q ? `${base}${base.includes('=') ? '&' : ''}q=${encodeURIComponent(q)}` : base);
const filters: { key?: EditorialStatus; label: string }[] = [{ label: 'Todas' }, ...statusOrder.map((k) => ({ key: k, label: statusLabel[k] }))];
---
<Admin title="Publicações" current="publicacoes">
  <div class="flex flex-col gap-6">
    <form method="get" role="search" class="flex max-w-[520px] gap-2">
      {status && <input type="hidden" name="status" value={status}>}
      <label for="q" class="sr-only">Buscar publicações</label>
      <input id="q" name="q" type="search" value={q} placeholder="Buscar por título, código ou endereço" autocomplete="off"
        class="h-11 min-w-0 flex-1 rounded-[6px] border border-line bg-bg px-3 text-[14px] text-ink focus-visible:border-lime">
      <button type="submit" class="min-h-11 shrink-0 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Buscar</button>
    </form>
    <div class="flex flex-wrap items-center justify-between gap-4">
    <nav aria-label="Filtrar por status">
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {filters.map((f) => {
          const active = f.key === status;
          return (
            <li>
              <a href={withQ(f.key ? `?status=${f.key}` : '?')} aria-current={active ? 'true' : undefined}
                class:list={['inline-flex min-h-9 items-center gap-2 rounded-full border px-4 text-sm', active ? 'border-lime text-lime' : 'border-line hover:border-ink']}>
                {f.label}{f.key && <span class="text-muted tabular-nums">{counts[f.key]}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <a href="/admin/publicacoes/nova/" class="inline-flex min-h-10 items-center rounded-[6px] bg-lime px-5 text-sm font-bold text-black hover:brightness-110">Nova publicação</a>
    </div>

    {posts.length === 0
      ? <p class="m-0 text-sm text-muted">{q ? <>Nada encontrado para “{q}”{status ? ' com esse status' : ''}. <a href={status ? `?status=${status}` : '?'} class="underline hover:text-ink">Limpar a busca</a></> : 'Nada com esse status.'}</p>
      : (
        <div class="overflow-x-auto rounded-[8px] border border-line">
          <table class="w-full min-w-[720px] border-collapse text-left text-sm">
            <thead class="text-[12px] text-muted">
              <tr class="border-b border-line">
                <th class="px-4 py-3 font-normal">Código</th><th class="px-4 py-3 font-normal">Título</th>
                <th class="px-4 py-3 font-normal">Departamento</th><th class="px-4 py-3 font-normal">Status</th>
                <th class="px-4 py-3 font-normal">Atualizada</th>
              </tr>
            </thead>
            <tbody>
              {posts.map((p) => (
                <tr class="border-b border-line last:border-b-0 hover:bg-[#0b0b0b]">
                  <td class="px-4 py-3 font-mono text-[12px] text-muted tabular-nums">{p.code ?? '—'}</td>
                  <td class="px-4 py-3"><a href={`/admin/publicacoes/${p.id}/`} class="hover:text-lime">{p.title || 'Sem título'}</a></td>
                  <td class="px-4 py-3 text-muted">{p.department}</td>
                  <td class="px-4 py-3">{statusLabel[p.status]}</td>
                  <td class="px-4 py-3 text-muted tabular-nums">{fmtDateTime(p.updatedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
  </div>
</Admin>
