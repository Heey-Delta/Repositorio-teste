---
// Edição de uma publicação existente
import Editor from '../../../components/admin/Editor.astro';
import { editorOptions, loadPost } from '../../../lib/posts';
export const prerender = false;
const [post, options] = await Promise.all([loadPost(Astro.params.id!), editorOptions()]);
if (!post) return new Response('Publicação não encontrada', { status: 404 });
---
<Editor id={post.id} draft={post.draft} updatedAt={post.updatedAt.toISOString()} login={Astro.locals.admin!.login} options={options} revisions={post.revisions} />
