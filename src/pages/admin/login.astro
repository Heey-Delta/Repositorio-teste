---
// Entrada do admin: um botão só, porque só uma conta (a do dono, no GitHub) tem acesso.
import Base from '../../layouts/Base.astro';
export const prerender = false;
if (Astro.locals.admin) return Astro.redirect('/admin/');
const errors: Record<string, string> = {
  conta: 'Essa conta do GitHub não tem acesso a este admin.',
  estado: 'O login expirou ou veio de outra aba. Tente de novo.',
  limite: 'Muitas tentativas seguidas. Espere 15 minutos.',
  github: 'O GitHub não respondeu como esperado. Tente de novo.',
};
const error = errors[Astro.url.searchParams.get('erro') ?? ''];
const fonts = 'https://fonts.googleapis.com/css2?family=Anton&display=swap';
---
<Base title="Entrar · Admin · Hallan" fonts={fonts}>
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow"></Fragment>
  <main class="grid min-h-dvh place-items-center px-5">
    <div class="flex w-full max-w-[360px] flex-col gap-6">
      <a href="/" class="font-display text-[32px] leading-none">/HALLAN</a>
      <div class="flex flex-col gap-2">
        <h1 class="m-0 text-xl font-bold">Entrar no admin</h1>
        <p class="m-0 text-sm text-muted">Área privada para gerenciar o Experimental Lab.</p>
      </div>
      {error && <p role="alert" class="m-0 rounded-[6px] border border-[#ff5a5a] px-4 py-3 text-sm text-[#ff8a8a]">{error}</p>}
      <a href="/api/auth/github" class="flex min-h-12 items-center justify-center gap-3 rounded-[8px] bg-lime px-6 text-sm font-bold text-black hover:brightness-110">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.7 18 5 18 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
        Entrar com GitHub
      </a>
    </div>
  </main>
</Base>
