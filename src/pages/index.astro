---
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Works from '../components/Works.astro';
import Stacks from '../components/Stacks.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Lab from '../components/Lab.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import DevPanel from '../components/DevPanel.astro';
import Visibility from '../components/Visibility.astro';
import { getAuthor, authorLd } from '../lib/lab-public';
import { services } from '../lib/site';


// SEO da página inicial: título e descrição que dizem o que você faz, endereço canônico, imagem de compartilhamento
// e dados estruturados (o site, a pessoa, que é a mesma identidade de autor do Lab, e o serviço profissional)
const title = 'Hallan · Web design e desenvolvimento de sites';
const description = 'Eu desenho e programo sites: web design, desenvolvimento web, landing pages, e-commerce, creative dev com 3D e branding digital.';
const home = new URL('/', Astro.site).href;
const image = new URL('/img/hero-statue.webp', Astro.site).href;
const person = authorLd(Astro.site, await getAuthor());
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#site`, name: 'Hallan', url: home, inLanguage: 'pt-BR', publisher: { '@id': person['@id'] } },
  { '@context': 'https://schema.org', ...person, image },
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': `${home}#servicos`, name: 'Hallan · Web design e desenvolvimento de sites',
    url: home, image, description, founder: { '@id': person['@id'] }, areaServed: { '@type': 'Country', name: 'Brasil' }, availableLanguage: 'pt-BR',
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'Serviços',
      itemListElement: services.map((sv) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: sv.name, description: `${sv.desc} ${sv.how}` } })),
    },
  },
];
---
<Base title={title} description={description} lang="pt-BR" analytics preloadFont>
  <Fragment slot="head">
    <link rel="canonical" href={home}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Hallan">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={home}>
    <meta property="og:image" content={image}>
    <meta property="og:image:alt" content="Estátua de mármore de um jovem de cabelos cacheados, sobre fundo preto">
    <meta property="og:locale" content="pt_BR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={image}>
    <link rel="alternate" type="application/rss+xml" title="Experimental Lab · Hallan" href={new URL('/lab/rss.xml', Astro.site).href}>
    {jsonld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </Fragment>
  <script slot="head" is:inline>
    // tela de abertura em toda visita à home
    (function () { var r = document.documentElement; r.classList.add('loading', 'intro');
      // as imagens da tela de carregamento só começam a baixar depois da foto do hero (que é o que o Google mede);
      // na prática isso leva uma fração de segundo, e há um limite de 1,2 s
      var ok = function () { r.classList.add('hero-ok'); };
      document.addEventListener('load', function (e) { if (e.target.getAttribute && e.target.getAttribute('fetchpriority') === 'high') ok(); }, true);
      setTimeout(ok, 1200);
    })();
  </script>
  <!-- a foto do hero é o maior elemento da primeira tela: começa a baixar antes de tudo (uma versão por tamanho de tela) -->
  <link slot="head" rel="preload" as="image" href="/img/hero-statue-m.webp" media="(max-width: 480px)" fetchpriority="high">
  <link slot="head" rel="preload" as="image" href="/img/hero-statue.webp" media="(min-width: 481px)" fetchpriority="high">


  <Loader />
  <Header />
  <main>
    <Hero />
    <Works />
    <Lab />
    <Stacks />
    <About />
    <Services />
    <Process />
    <Contact />
  </main>
  <Footer />
  <Visibility />
  <DevPanel />
</Base>
