---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Works from '../components/Works.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Lab from '../components/Lab.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import DevPanel from '../components/DevPanel.astro';

const fonts = 'https://fonts.googleapis.com/css2?family=Anton&family=Chakra+Petch:wght@400;500;600&display=swap';
---
<Base title="/DV · Digital Experience Designer" description="I build digital experiences: web design, web development, landing pages, e-commerce, creative dev and digital branding." fonts={fonts} lang="en">
  <script slot="head" is:inline>document.documentElement.classList.add('loading');</script>
  <!-- Visual do card dos prédios da cidade (o mesmo do card interno); o card abre por fora, ver CityCard -->
  <link slot="head" rel="stylesheet" href="widgets/cidade-isometrica/card.css">

  <Loader />
  <Header />
  <main>
    <Hero />
    <Works />
    <About />
    <Services />
    <Process />
    <Lab />
    <Contact />
  </main>
  <Footer />
  <DevPanel />
</Base>
