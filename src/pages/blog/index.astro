---
// Lista de todos os posts (os da landing são só os 3 mais recentes).
import Blog from '../../layouts/Blog.astro';
import PostCard from '../../components/PostCard.astro';
import { byDateDesc } from '../../data/blog';
const posts = byDateDesc();
---
<Blog title="Todos os posts" description="Artigos sobre sites, design e o que eu aprendo no caminho." root="../" prose={false}>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6">
    {posts.map((post) => <PostCard post={post} href={`${post.slug}/index.html`} />)}
  </div>
</Blog>
