---
// Layout do Experimental Lab (/lab/...): SEO (canonical, Open Graph, dados estruturados, noindex em rascunhos),
// cabeçalho com o menu compacto do laboratório, busca global (título, código, tag, área) e rodapé.
import '../styles/global.css';
import Base from './Base.astro';
import LabIcon from '../components/lab/LabIcon.astro';
import { getLabEntries, getAuthor, authorLd } from '../lib/lab-public';
import { departments, departmentBySlug, up, LAB_NAME } from '../lab/data';

interface Crumb { name: string; path: string; }
interface Props {
  title: string; description: string; depth: number;
  noindex?: boolean; current?: string; crumbs?: Crumb[];
  jsonld?: Record<string, unknown>[]; ogType?: string; canonical?: string; ogImage?: { url: string; alt: string } | null;
  article?: { published: Date; modified: Date; section: string; tags: string[] };
}
const { title, description, depth, noindex = false, current = 'overview', crumbs = [], jsonld = [], ogType = 'website', canonical: canonicalOverride, ogImage: ogOverride, article } = Astro.props;
// sem capa, a imagem de compartilhamento é a do laboratório na página inicial
const ogImage = ogOverride ?? { url: new URL('/img/laboratorio.webp', Astro.site).href, alt: 'Cúpula escura sobre uma cidade em ruínas, em meio-tom preto e branco' };
const root = up(depth);
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = `${title} · ${LAB_NAME} · Hallan`;

// trilha de navegação também como dado estruturado (o Google mostra no resultado)
const allCrumbs = [{ name: 'Hallan', path: '/' }, { name: LAB_NAME, path: '/lab/' }, ...crumbs];
const ld = [
  { '@context': 'https://schema.org', ...authorLd(Astro.site, await getAuthor()) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: allCrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).href })) },
  ...jsonld,
];

// índice da busca global
const index = (await getLabEntries()).map((e) => ({
  t: e.data.title, c: e.data.code ?? '', d: departmentBySlug(e.data.department).name,
  k: [...e.data.tags, ...e.data.areas].join(' '),
  u: `${root}lab/${e.data.department}/${e.id.split('/').pop()}/`,
}));
const nav = [{ slug: 'overview', name: 'Visão geral', href: `${root}lab/` }, ...departments.map((d) => ({ slug: d.slug, name: d.slug === 'visual-archive' ? 'Acervo' : d.slug === 'open-lab' ? 'Lab aberto' : d.name, href: `${root}lab/${d.slug}/` }))];
---
<Base title={fullTitle} description={description} lang="pt-BR" bodyClass="lab-body" analytics={!noindex} preloadFont>
  <Fragment slot="head">
    <link rel="canonical" href={canonical}>
    {noindex && <meta name="robots" content="noindex, follow">}
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content={`${LAB_NAME} · Hallan`}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:locale" content="pt_BR">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:image" content={ogImage.url}><meta property="og:image:alt" content={ogImage.alt}><meta name="twitter:image" content={ogImage.url}>
    {article && <>
      <meta property="article:published_time" content={article.published.toISOString()}>
      <meta property="article:modified_time" content={article.modified.toISOString()}>
      <meta property="article:author" content="Hallan">
      <meta property="article:section" content={article.section}>
      {article.tags.map((t) => <meta property="article:tag" content={t}>)}
    </>}
    <link rel="alternate" type="application/rss+xml" title={`${LAB_NAME} · Hallan`} href={new URL('/lab/rss.xml', Astro.site).href}>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </Fragment>

  <header class="sticky top-0 z-50 border-b border-line bg-bg/95">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={root} class="font-display text-[26px] leading-none" aria-label="Hallan, voltar ao site"><span class="text-accent">/</span>HAS</a>
      <nav class="hidden items-center gap-5 xl:flex" aria-label="Laboratório">
        {nav.map((n) => (
          <a href={n.href} class:list={['label-ui flex items-center gap-2 text-[11px] whitespace-nowrap hover:text-accent', n.slug === current ? 'text-accent' : 'text-ink']} aria-current={n.slug === current ? 'page' : undefined}>
            {n.slug === current && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>}{n.name}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-1">
        <button type="button" id="labSearchBtn" class="grid size-11 cursor-pointer place-items-center hover:text-accent" aria-label="Buscar no laboratório" aria-expanded="false" aria-controls="labSearch"><LabIcon name="search" class="size-5" /></button>
        <button type="button" id="labMenuBtn" class="grid size-11 cursor-pointer place-items-center hover:text-accent xl:hidden" aria-label="Abrir menu" aria-expanded="false" aria-controls="labMenu">
          <svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true"><path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
      </div>
    </div>
    <nav id="labMenu" class="hidden border-t border-line bg-bg xl:hidden" aria-label="Laboratório (celular)">
      <div class="wrap grid py-2">
        {nav.map((n) => <a href={n.href} class:list={['label-ui border-b border-line py-3.5 text-[13px] last:border-b-0 hover:text-accent', n.slug === current && 'text-accent']}>{n.name}</a>)}
      </div>
    </nav>
    <div id="labSearch" class="hidden max-h-[calc(100dvh-64px)] overflow-y-auto border-t border-line bg-bg">
      <div class="wrap flex flex-col gap-3 py-4">
        <label for="labSearchInput" class="text-xs text-muted">Busque por assunto, título, código ou tag. Não precisa ser a palavra exata: "inteligência artificial" também encontra "IA".</label>
        <input id="labSearchInput" type="search" autocomplete="off" enterkeyhint="search" class="h-12 w-full rounded-full border border-line bg-bg px-5 text-[15px] text-ink focus-visible:border-accent" placeholder="cérebro, IA, EXP-001, #tipografia…">
        <ul id="labSearchTags" class="m-0 flex list-none gap-1.5 overflow-x-auto p-0 pb-1 [scrollbar-width:none] sm:flex-wrap" aria-label="Tags"></ul>
        <p id="labSearchState" class="m-0 min-h-4 text-xs text-muted" role="status"></p>
        <ul id="labSearchOut" class="m-0 grid list-none gap-2 p-0"></ul>
      </div>
    </div>
  </header>

  {crumbs.length > 0 && (
    <nav class="wrap pt-5 text-xs text-muted" aria-label="Você está em">
      <a href={`${root}lab/`} class="hover:text-accent">Laboratório</a>
      {crumbs.map((c, i) => <> <span aria-hidden="true">/</span> {i < crumbs.length - 1 ? <a href={`${root}${c.path.slice(1)}`} class="hover:text-accent">{c.name}</a> : <span class="text-ink">{c.name}</span>}</>)}
    </nav>
  )}

  <main><slot /></main>

  <footer class="mt-0 border-t border-line">
    <div class="wrap flex flex-col gap-6 py-8 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center">
      <div class="flex items-center gap-4"><a href={root} class="font-display text-[26px] leading-none" aria-label="Hallan, voltar ao site"><span class="text-accent">/</span>HAS</a><span class="text-xs text-muted">Laboratório Experimental do Hallan</span></div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-[13px]" aria-label="Rodapé do laboratório">
        <a href={`${root}lab/`} class="hover:text-accent">Laboratório</a>
        <a href={`${root}lab/autor/`} class="hover:text-accent">Autor</a>
        <a href={`${root}#works`} class="hover:text-accent">Trabalhos</a>
        <a href={`${root}#about`} class="hover:text-accent">Sobre</a>
        <a href={`${root}#contact`} class="hover:text-accent">Contato</a>
      </nav>
      <a href={`${root}#contact`} class="label-ui self-start text-xs hover:text-accent lg:justify-self-end">Falar comigo →</a>
    </div>
    <div class="wrap flex flex-wrap justify-between gap-2 border-t border-line py-5 text-xs text-muted">
      <span class="tabular-nums">© 2026 Hallan</span>
    </div>
  </footer>

  <script is:inline define:vars={{ index }}>
    (function () {
      function toggle(btn, panel, other) {
        var open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open)); panel.classList.toggle('hidden', !open);
        if (open && other) { other.btn.setAttribute('aria-expanded', 'false'); other.panel.classList.add('hidden'); }
        return open;
      }
      var sBtn = document.getElementById('labSearchBtn'), sPanel = document.getElementById('labSearch');
      var mBtn = document.getElementById('labMenuBtn'), mPanel = document.getElementById('labMenu');
      var input = document.getElementById('labSearchInput'), out = document.getElementById('labSearchOut');
      sBtn.addEventListener('click', function () { if (toggle(sBtn, sPanel, { btn: mBtn, panel: mPanel })) input.focus(); });
      mBtn.addEventListener('click', function () { toggle(mBtn, mPanel, { btn: sBtn, panel: sPanel }); });
      // busca: primeiro no servidor (significado + palavras + tags); sem rede, filtra o índice desta página
      var norm = function (s) { return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); };
      var items = index.map(function (i) { return { i: i, s: norm(i.t + ' ' + i.c + ' ' + i.d + ' ' + i.k) }; });
      var tagsBox = document.getElementById('labSearchTags'), state = document.getElementById('labSearchState');
      var tag = null, timer = null, seq = 0, tagsLoaded = false;
      var el = function (tagName, cls, text) { var n = document.createElement(tagName); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
      var show = function (list, note) {
        out.innerHTML = ''; state.textContent = note || '';
        list.forEach(function (h) {
          var li = el('li'), a = el('a', 'group grid grid-cols-[72px_1fr] items-center gap-3 rounded-2xl border border-line p-2 hover:border-ink');
          a.href = h.url;
          var th = el('span', 'block aspect-[16/10] overflow-hidden rounded-[10px] border border-line bg-[#111]');
          if (h.cover) { var im = el('img', 'h-full w-full object-cover'); im.src = h.cover; im.alt = ''; im.loading = 'lazy'; th.appendChild(im); }
          var tx = el('span', 'flex min-w-0 flex-col gap-1');
          tx.appendChild(el('span', 'text-[15px] leading-tight group-hover:text-accent', h.title));
          tx.appendChild(el('span', 'text-[12px] text-muted', h.meta));
          a.appendChild(th); a.appendChild(tx); li.appendChild(a); out.appendChild(li);
        });
      };
      var local = function (q) {
        var w = norm(q).split(/\s+/).filter(Boolean);
        return items.filter(function (x) { return w.every(function (t) { return x.s.indexOf(t) >= 0; }); }).slice(0, 12)
          .map(function (x) { return { url: x.i.u, title: x.i.t, meta: [x.i.d, x.i.c].filter(Boolean).join(' · ') }; });
      };
      var run = function () {
        var q = input.value.trim(), my = ++seq;
        if (q.length < 2 && !tag) { show([]); return; }
        state.textContent = 'Buscando…';
        fetch('/api/lab/busca?q=' + encodeURIComponent(q) + (tag ? '&tag=' + encodeURIComponent(tag) : ''))
          .then(function (r) { if (!r.ok) throw 0; return r.json(); })
          .then(function (d) {
            if (my !== seq) return;
            var list = d.items.map(function (h) {
              if (h.kind === 'volume') return { url: h.volume.url, title: h.volume.title, cover: h.volume.cover && h.volume.cover.url, meta: 'Volume · ' + h.volume.count + ' artigos' + (h.how === 'significado' ? ' · por assunto' : '') };
              return { url: h.card.url, title: h.card.title, cover: h.card.cover && h.card.cover.url, meta: [h.card.deptName, h.card.code, h.how === 'significado' ? 'por assunto' : ''].filter(Boolean).join(' · ') };
            });
            show(list, list.length ? list.length + (list.length === 1 ? ' resultado' : ' resultados') + (tag ? ' com a tag selecionada' : '') : 'Nada encontrado. Tente outra palavra ou uma tag.');
          })
          .catch(function () { if (my !== seq) return; var l = local(q); show(l, l.length ? '' : 'Nada com "' + q + '". Tente outra palavra.'); });
      };
      var loadTags = function () {
        if (tagsLoaded) return; tagsLoaded = true;
        fetch('/api/lab/busca?tags=1').then(function (r) { return r.json(); }).then(function (d) {
          (d.tags || []).forEach(function (t) {
            var li = el('li', 'shrink-0'), b = el('button', 'min-h-9 whitespace-nowrap cursor-pointer rounded-full border border-line px-3 text-[12px] text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent', '#' + t.name);
            b.type = 'button'; b.setAttribute('aria-pressed', 'false');
            b.addEventListener('click', function () {
              var on = tag !== t.slug; tag = on ? t.slug : null;
              tagsBox.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
              b.setAttribute('aria-pressed', String(on)); run();
            });
            li.appendChild(b); tagsBox.appendChild(li);
          });
        }).catch(function () { tagsLoaded = false; });
      };
      sBtn.addEventListener('click', loadTags);
      input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 250); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { sBtn.setAttribute('aria-expanded', 'false'); sPanel.classList.add('hidden'); mBtn.setAttribute('aria-expanded', 'false'); mPanel.classList.add('hidden'); }
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') { e.preventDefault(); if (sPanel.classList.contains('hidden')) sBtn.click(); else input.focus(); }
      });
    })();
  </script>
  <script is:inline>
    // Curtidas: marca o que este visitante já curtiu, atualiza as contagens e curte/descurte no clique.
    (function () {
      var api = '/api/lab/curtir';
      var all = function (id) { return document.querySelectorAll('[data-like="' + id + '"]'); };
      var paint = function (id, liked, count) {
        all(id).forEach(function (b) {
          if (liked != null) b.setAttribute('aria-pressed', String(liked));
          if (count != null) { var c = b.querySelector('[data-like-count]'); if (c) c.textContent = count; b.setAttribute('aria-label', (b.getAttribute('aria-pressed') === 'true' ? 'Descurtir' : 'Curtir') + ': ' + count + (count === 1 ? ' curtida' : ' curtidas')); }
        });
      };
      var sync = function (ids) {
        ids = ids.filter(Boolean); if (!ids.length) return;
        fetch(api + '?ids=' + ids.slice(0, 100).join(','), { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
          if (!d) return;
          Object.keys(d.counts).forEach(function (id) { paint(id, d.liked.indexOf(id) >= 0, d.counts[id]); });
        }).catch(function () {});
      };
      window.labLikes = { sync: sync };
      var ids = Array.prototype.map.call(document.querySelectorAll('[data-like]'), function (b) { return b.dataset.like; });
      sync(ids.filter(function (x, i) { return ids.indexOf(x) === i; }));
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-like]');
        if (!b) return;
        e.preventDefault();
        var id = b.dataset.like, was = b.getAttribute('aria-pressed') === 'true';
        var n = Number((b.querySelector('[data-like-count]') || {}).textContent || 0);
        paint(id, !was, Math.max(0, n + (was ? -1 : 1)));
        b.classList.add('pop'); setTimeout(function () { b.classList.remove('pop'); }, 180);
        fetch(api, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ postId: id }) })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (d) { paint(id, d.liked, d.count); })
          .catch(function () { paint(id, was, n); });
      });
    })();
  </script>
</Base>
<style is:global>
  .wire { background: repeating-linear-gradient(135deg, transparent 0 14px, rgb(255 255 255 / .05) 14px 15px), #0b0b0b; border: 1px dashed var(--line); }
</style>
