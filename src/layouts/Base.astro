---
// Estrutura comum das páginas: <head> e o slot do conteúdo. O CSS vem de quem usa o Base: home.css na home,
// global.css no Lab e no admin. As fontes (Anton e Chakra Petch) ficam no próprio site,
// em public/fonts (declaradas em styles/fonts.css); `preloadFont` adianta as três partes usadas (Anton e Chakra Petch 400/600).
import fontsCss from '../styles/fonts.css?raw';
interface Props { title: string; description?: string; preloadFont?: boolean; lang?: string; icon?: string; bodyClass?: string; analytics?: boolean; }
const { title, description, preloadFont = false, lang = 'pt-BR', icon, bodyClass, analytics = false } = Astro.props;
// Vercel Web Analytics (só nas páginas públicas e só no build do Vercel: fora dele o script não existe)
const withAnalytics = analytics && import.meta.env.PROD && Boolean(process.env.VERCEL);
---
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {icon
    ? <link rel="icon" href={icon} type="image/svg+xml">
    : <><link rel="icon" href="/favicon.ico" sizes="48x48"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"></>}
  <slot name="head" />
  {withAnalytics && <script defer src="/_vercel/insights/script.js" is:inline></script>}
  {preloadFont && <>
    <link rel="preload" href="/fonts/anton-400-up.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/chakra-petch-400-up.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/chakra-petch-600-up.woff2" as="font" type="font/woff2" crossorigin>
  </>}
  <style is:inline set:html={fontsCss}></style>
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
