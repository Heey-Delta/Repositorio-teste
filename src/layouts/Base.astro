---
// Estrutura comum das páginas: <head> e o slot do conteúdo. As fontes (Anton e Chakra Petch) ficam no próprio site,
// em public/fonts (declaradas em global.css); `preloadFont` adianta a Anton, que é a dos títulos grandes.
import '../styles/global.css';
interface Props { title: string; description?: string; preloadFont?: boolean; lang?: string; icon?: string; bodyClass?: string; analytics?: boolean; }
const { title, description, preloadFont = false, lang = 'pt-BR', icon, bodyClass, analytics = false } = Astro.props;
// Vercel Web Analytics (só nas páginas públicas e só no build do Vercel: fora dele o script não existe)
const withAnalytics = analytics && import.meta.env.PROD && Boolean(process.env.VERCEL);
---
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {icon && <link rel="icon" href={icon} type="image/svg+xml">}
  <slot name="head" />
  {withAnalytics && <script defer src="/_vercel/insights/script.js" is:inline></script>}
  {preloadFont && <link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin>}
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
