---
// Layout dos posts do blog e da lista de posts. Quem escreve um post só precisa de:
//   <Blog title="..." date="AAAA-MM-DD" tag="..." description="...">  ...HTML do post...  </Blog>
// `root` é o caminho até a raiz do site: '../../' para um post (blog/<slug>/index.html) e '../' para blog/index.html.
import Base from './Base.astro';
import Brand from '../components/Brand.astro';
import { formatDate } from '../data/blog';
interface Props { title: string; description?: string; date?: string; tag?: string; root?: string; prose?: boolean; }
const { title, description, date, tag, root = '../../', prose = true } = Astro.props;
const fonts = 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap';
const home = `${root}index.html`;
const blogList = `${root}blog/index.html`;
const isList = !date;
---
<Base title={`${title} · Blog`} description={description} fonts={fonts}>
  <header class="border-b border-line bg-paper">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-[18px]">
      <Brand href={home} />
      <nav class="flex flex-wrap items-center gap-x-[22px] gap-y-2 text-[15px]" aria-label="Blog">
        <a href={`${home}#blog`} class="text-ink-soft no-underline hover:text-ink">← Portfólio</a>
        {!isList && <a href={blogList} class="text-ink-soft no-underline hover:text-ink">Todos os posts</a>}
      </nav>
    </div>
  </header>

  <main class="wrap section-y">
    <article>
      <header class="mb-8 grid max-w-[68ch] gap-4">
        {date && <p class="eyebrow m-0"><time datetime={date}>{formatDate(date)}</time>{tag && <> · {tag}</>}</p>}
        {isList && <span class="eyebrow">Blog</span>}
        <h1 class="text-[clamp(34px,5vw,56px)] leading-[1.05] font-extrabold">{title}</h1>
        {description && <p class="text-[clamp(18px,2vw,21px)] text-ink-soft">{description}</p>}
      </header>
      <div class:list={[prose && 'post-body']}><slot /></div>
    </article>
  </main>

  <footer class="border-t border-line py-6 text-[14px] text-ink-soft">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <span>© [Seu nome]. Sites para negócios do bairro.</span>
      <a href={`${home}#blog`} class="text-ink-soft hover:text-ink">← Voltar ao portfólio</a>
    </div>
  </footer>
</Base>
