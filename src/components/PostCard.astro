---
// Cartão de um post: o link cobre o cartão inteiro (after:absolute). `href` já vem relativo à página que usa o cartão.
import { formatDate, type Post } from '../data/blog';
interface Props { post: Post; href: string; }
const { post, href } = Astro.props;
---
<article class="group relative grid content-start gap-3 rounded-[14px] border border-line bg-paper p-6 transition-colors hover:border-ink">
  <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] leading-[1.2] tracking-[0.06em] text-ink-soft uppercase">
    <time datetime={post.date}>{formatDate(post.date)}</time><span aria-hidden="true">·</span><span>{post.tag}</span>
  </p>
  <h3 class="text-[22px] leading-[1.15] font-semibold">
    <a href={href} class="text-ink no-underline after:absolute after:inset-0 after:content-['']">{post.title}</a>
  </h3>
  <p class="text-[16px] text-ink-soft">{post.summary}</p>
  <span class="mt-1 text-[15px] font-semibold text-accent" aria-hidden="true">Ler o post <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
</article>
