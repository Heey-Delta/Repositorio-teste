---
const field = 'h-12 w-full border border-line bg-surface px-4 text-[15px] text-ink placeholder:text-muted';
const label = 'text-xs text-muted';
---
<section id="contact" class="border-b border-line bg-surface" aria-labelledby="contact-title">
  <div class="wrap grid gap-10 py-10 pb-12 lg:min-h-[700px] lg:grid-cols-2 lg:gap-20 lg:py-20">
    <div class="flex flex-col justify-between gap-10 lg:gap-12">
      <div class="flex flex-col gap-4 lg:gap-7">
        <h2 id="contact-title" class="font-display text-[clamp(52px,16vw,72px)] leading-[0.98] uppercase lg:text-[clamp(84px,7.2vw,104px)]">Tem um<br>projeto<br><span class="text-lime">em mente?</span></h2>
        <p class="max-w-[260px] text-base text-muted lg:max-w-[300px] lg:text-lg">Vamos transformar a sua ideia em algo extraordinário.</p>
      </div>
      <div class="flex flex-wrap gap-x-14 gap-y-5">
        <a href="https://wa.me/[SEU-NUMERO]" class="flex items-center gap-3.5 hover:text-lime">
          <span class="grid size-10 place-items-center rounded-full border border-ink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3.5-7.1L21 3l-1 4a9 9 0 0 1 1 5z"/></svg></span>
          <span><span class="block font-ui text-[15px] font-medium">WhatsApp</span><span class="block text-[13px] text-muted">Fale agora</span></span>
        </a>
        <a href="mailto:[seu@email.com]" class="flex items-center gap-3.5 hover:text-lime">
          <span class="grid size-10 place-items-center border border-ink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18v14H3zM3 5l9 8 9-8"/></svg></span>
          <span><span class="block font-ui text-[15px] font-medium">E-mail</span><span class="block text-[13px] text-muted">Mande uma mensagem</span></span>
        </a>
      </div>
    </div>
    <form id="contactForm" class="flex flex-col justify-center gap-2.5 lg:gap-3.5 lg:border-l lg:border-line lg:pl-16" novalidate>
      <label for="c-name" class={label}>Seu nome</label>
      <input id="c-name" type="text" class={field} placeholder="Seu nome" autocomplete="name">
      <label for="c-mail" class={label}>Seu e-mail</label>
      <input id="c-mail" type="email" class={field} placeholder="Seu e-mail" autocomplete="email">
      <label for="c-type" class={label}>Tipo de projeto</label>
      <select id="c-type" class={`${field} text-muted`}><option>Tipo de projeto</option><option>Web Design</option><option>Desenvolvimento Web</option><option>Landing Page</option><option>E-commerce</option></select>
      <label for="c-msg" class={label}>Mensagem</label>
      <textarea id="c-msg" class={`${field} h-[120px] resize-none py-3 lg:h-[150px]`} placeholder="Conte sobre o seu projeto..."></textarea>
      <button type="submit" class="label-ui mt-1.5 min-h-12 cursor-pointer self-start bg-lime px-7 text-xs font-bold text-black hover:brightness-110">Enviar mensagem →</button>
      <p id="contactMsg" class="m-0 min-h-6 text-sm text-lime" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script is:inline>
  // Formulário de demonstração: ainda não envia nada (falta ligar a um serviço de e-mail)
  document.getElementById('contactForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var name = document.getElementById('c-name').value.trim();
    document.getElementById('contactMsg').textContent = 'Obrigado' + (name ? ', ' + name : '') + '. (Demonstração: nada foi enviado ainda.)';
  });
</script>
