---
const field = 'h-12 w-full border border-line bg-surface px-4 text-[15px] text-ink placeholder:text-muted';
const label = 'text-xs text-muted';
---
<section id="contact" class="border-b border-line bg-surface" aria-labelledby="contact-title">
  <div class="wrap grid gap-10 py-10 pb-12 lg:min-h-[700px] lg:grid-cols-2 lg:gap-20 lg:py-20">
    <div class="flex flex-col justify-between gap-10 lg:gap-12">
      <div class="flex flex-col gap-4 lg:gap-7">
        <h2 id="contact-title" class="font-display text-[clamp(52px,16vw,72px)] leading-[0.98] uppercase lg:text-[clamp(84px,7.2vw,104px)]">Tem um<br>projeto<br><span class="text-lime">em mente?</span></h2>
        <p class="max-w-[260px] text-base text-muted lg:max-w-[300px] lg:text-lg">Vamos transformar a sua ideia em algo extraordinário.</p>
      </div>
      <div class="flex flex-wrap gap-x-14 gap-y-5">
        <a href="https://wa.me/[SEU-NUMERO]" class="flex items-center gap-3.5 hover:text-lime">
          <span class="grid size-10 place-items-center rounded-full border border-ink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3.5-7.1L21 3l-1 4a9 9 0 0 1 1 5z"/></svg></span>
          <span><span class="block font-ui text-[15px] font-medium">WhatsApp</span><span class="block text-[13px] text-muted">Fale agora</span></span>
        </a>
        <a href="mailto:hello.hallan.dante@gmail.com" class="flex min-w-0 items-center gap-3.5 hover:text-lime">
          <span class="grid size-10 place-items-center border border-ink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18v14H3zM3 5l9 8 9-8"/></svg></span>
          <span class="min-w-0"><span class="block font-ui text-[15px] font-medium">E-mail</span><span class="block text-[13px] break-all text-muted">hello.hallan.dante@gmail.com</span></span>
        </a>
      </div>
    </div>
    <form id="contactForm" class="flex flex-col justify-center gap-2.5 lg:gap-3.5 lg:border-l lg:border-line lg:pl-16" novalidate>
      <label for="c-name" class={label}>Seu nome</label>
      <input id="c-name" type="text" class={field} placeholder="Seu nome" autocomplete="name" required>
      <label for="c-mail" class={label}>Seu e-mail</label>
      <input id="c-mail" type="email" class={field} placeholder="voce@exemplo.com" autocomplete="email" inputmode="email" required>
      <label for="c-phone" class={label}>Telefone para contato</label>
      <input id="c-phone" type="tel" class={field} placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" required>
      <label for="c-msg" class={label}>Por qual motivo você entrou em contato comigo?</label>
      <textarea id="c-msg" class={`${field} h-[160px] resize-none py-3 lg:h-[200px]`} placeholder="Conte o problema que você quer resolver..." required></textarea>
      <button type="submit" class="label-ui mt-1.5 min-h-12 cursor-pointer self-start bg-lime px-7 text-xs font-bold text-black hover:brightness-110">Enviar mensagem →</button>
      <p id="contactMsg" class="m-0 min-h-6 text-sm text-lime" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script is:inline>
  // Envio para o Google Forms (sem servidor): os dados vão por POST para o endereço "formResponse" do formulário e caem na planilha.
  // Para ligar: troque os códigos de ENTRY (formato 'entry.1234567890') pelos do seu formulário. No Google Forms: ⋮ > "Obter link
  // pré-preenchido", preencha cada pergunta com um texto qualquer, copie o link e leia os códigos entry.NNN do endereço.
  // O Google não devolve resposta legível ao navegador (modo no-cors): o site assume que deu certo se a rede não falhou.
  (function () {
    var FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSdWEqi2Mp42GP7E2M0zHxAC-iZIEbmM3oBxq3JFR9ENutgqGw/formResponse';
    // Códigos das perguntas do Google Form. O e-mail não é uma pergunta: o Form está com "Coletar endereços de e-mail" ligado,
    // e esse campo vai com o nome fixo emailAddress (precisa estar no modo "Informado pelo participante", não "Verificado").
    var ENTRY = { name: 'entry.682636224', mail: 'emailAddress', phone: 'entry.997714580', msg: 'entry.1761479786' };
    var form = document.getElementById('contactForm'), out = document.getElementById('contactMsg');
    var btn = form.querySelector('button[type=submit]'), busy = false;
    function say(t, bad) { out.textContent = t; out.classList.toggle('text-lime', !bad); out.classList.toggle('text-[#ff6b6b]', !!bad); }
    // máscara do telefone: (00) 00000-0000 ou (00) 0000-0000
    form['c-phone'].addEventListener('input', function () {
      var d = this.value.replace(/\D/g, '').slice(0, 11), o = d;
      if (d.length > 2) o = '(' + d.slice(0, 2) + ') ' + d.slice(2);
      if (d.length > 6) o = '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length - 4) + '-' + d.slice(-4);
      this.value = o;
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault(); if (busy) return;
      var v = { name: form['c-name'].value.trim(), mail: form['c-mail'].value.trim(), phone: form['c-phone'].value.trim(), msg: form['c-msg'].value.trim() };
      var digits = v.phone.replace(/\D/g, '');
      if (!v.name) { say('Preencha o seu nome.', true); form['c-name'].focus(); return; }
      // e-mail válido: regra do próprio navegador (type=email) + domínio com ponto e terminação de 2 letras ou mais
      if (!form['c-mail'].checkValidity() || !/^[^@\s]+@[^@\s.]+(\.[^@\s.]+)*\.[a-z]{2,}$/i.test(v.mail)) { say('Digite um e-mail válido (ex.: voce@exemplo.com).', true); form['c-mail'].focus(); return; }
      if (digits.length < 10 || digits.length > 13) { say('Digite um telefone válido, com DDD.', true); form['c-phone'].focus(); return; }
      if (v.msg.length < 10) { say('Conte um pouco mais sobre o motivo do contato.', true); form['c-msg'].focus(); return; }
      if (!ENTRY.name || !ENTRY.mail || !ENTRY.phone || !ENTRY.msg) { say('Formulário ainda não configurado: faltam os códigos das perguntas.', true); return; }
      var body = new URLSearchParams();
      body.set(ENTRY.name, v.name); body.set(ENTRY.mail, v.mail); body.set(ENTRY.phone, v.phone); body.set(ENTRY.msg, v.msg);
      busy = true; btn.disabled = true; btn.classList.add('opacity-60'); say('Enviando…');
      fetch(FORM_URL, { method: 'POST', mode: 'no-cors', body: body }).then(function () {
        form.reset(); say('Obrigado, ' + v.name + '! Recebi sua mensagem e respondo em breve.');
      }, function () {
        say('Não consegui enviar. Tente de novo ou escreva por e-mail ou WhatsApp.', true);
      }).then(function () { busy = false; btn.disabled = false; btn.classList.remove('opacity-60'); });
    });
  })();
</script>
