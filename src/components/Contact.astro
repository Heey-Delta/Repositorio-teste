---
import { siWhatsapp, siGmail } from 'simple-icons';
// Número do WhatsApp só com dígitos, com DDI e DDD (ex.: '5511999999999'). Vazio: o contato por WhatsApp não aparece.
const WHATSAPP = '';
const EMAIL = 'hello.hallan.dante@gmail.com';
const field = 'h-12 w-full border border-line bg-surface px-4 text-[15px] text-ink placeholder:text-muted';
const label = 'text-xs text-muted';
const channels = [
  WHATSAPP && { href: `https://wa.me/${WHATSAPP}`, icon: siWhatsapp, name: 'WhatsApp', detail: '' },
  { href: `mailto:${EMAIL}`, icon: siGmail, name: 'E-mail', detail: EMAIL },
].filter(Boolean) as { href: string; icon: { path: string }; name: string; detail: string }[];
---
<section id="contact" class="border-b border-line bg-surface" aria-labelledby="contact-title">
  <div class="wrap grid gap-10 py-10 pb-12 lg:min-h-[700px] lg:grid-cols-2 lg:gap-20 lg:py-20">
    <div class="flex flex-col justify-between gap-10 lg:gap-12">
      <div class="flex flex-col gap-4 lg:gap-7">
        <h2 id="contact-title" class="font-display text-[clamp(52px,16vw,72px)] leading-[0.98] uppercase lg:text-[clamp(84px,7.2vw,104px)]">Tem um<br>projeto<br><span class="text-accent">em mente?</span></h2>
        <p class="max-w-[300px] text-base text-muted lg:max-w-[340px] lg:text-lg">Conte o que você precisa e eu respondo com os próximos passos.</p>
      </div>
      <div class="flex flex-wrap gap-x-14 gap-y-5">
        {channels.map((c) => (
          <a href={c.href} class="flex min-w-0 items-center gap-3.5 hover:text-accent">
            <span class="grid size-10 shrink-0 place-items-center border border-ink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={c.icon.path} /></svg></span>
            <span class="min-w-0"><span class="block text-[15px] font-bold">{c.name}</span>{c.detail && <span class="block text-[13px] break-all text-muted">{c.detail}</span>}</span>
          </a>
        ))}
      </div>
    </div>
    <form id="contactForm" class="flex flex-col justify-center gap-5 lg:gap-6 lg:border-l lg:border-line lg:pl-16" novalidate>
      <div class="flex flex-col gap-1.5">
        <label for="c-name" class={label}>Nome</label>
        <input id="c-name" type="text" class={field} autocomplete="name" required>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="c-mail" class={label}>E-mail</label>
        <input id="c-mail" type="email" class={field} placeholder="voce@exemplo.com" autocomplete="email" inputmode="email" required>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="c-phone" class={label}>Telefone com DDD</label>
        <input id="c-phone" type="tel" class={`${field} tabular-nums`} placeholder="(00) 00000-0000" autocomplete="tel" inputmode="tel" required>
      </div>
      <div class="flex flex-col gap-1.5">
        <label for="c-msg" class={label}>O que você precisa?</label>
        <textarea id="c-msg" class={`${field} h-[160px] resize-none py-3 lg:h-[200px]`} placeholder="Ex.: um site para a minha pizzaria, com cardápio e pedido pelo WhatsApp." required></textarea>
      </div>
      <div class="flex flex-col gap-3">
        <button type="submit" class="label-ui inline-flex min-h-14 cursor-pointer items-center justify-center gap-3 bg-accent px-8 text-[13px] font-bold text-black hover:brightness-110 disabled:cursor-wait sm:self-start">
          <span class="send-spin hidden size-4 rounded-full border-2 border-black/25 border-t-black" aria-hidden="true"></span><span class="send-label">Enviar mensagem →</span>
        </button>
        <p id="contactMsg" class="m-0 min-h-6 text-sm text-accent" role="status" aria-live="polite"></p>
        <a id="contactFallback" href="#" target="_blank" rel="noopener" class="label-ui hidden self-start border border-ink px-5 py-3 text-xs hover:border-accent hover:text-accent">Enviar pelo Google Forms ↗</a>
      </div>
    </form>
  </div>
</section>
<script is:inline>
  // Envio para o Google Forms (sem servidor): os dados vão por POST para o endereço "formResponse" do formulário e caem na planilha.
  // Para ligar: troque os códigos de ENTRY (formato 'entry.1234567890') pelos do seu formulário. No Google Forms: ⋮ > "Obter link
  // pré-preenchido", preencha cada pergunta com um texto qualquer, copie o link e leia os códigos entry.NNN do endereço.
  // O Google não devolve resposta legível ao navegador (modo no-cors): o site assume que deu certo se a rede não falhou.
  // Se o envio for bloqueado (ex.: dentro do artefato do claude.ai, que não deixa a página falar com outros sites), aparece um botão
  // que abre o Google Form já preenchido numa aba nova; a pessoa só confirma o envio lá.
  // Retorno visual: campo com erro fica vermelho e treme; durante o envio o botão mostra um indicador girando; a mensagem entra deslizando.
  (function () {
    var FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSdWEqi2Mp42GP7E2M0zHxAC-iZIEbmM3oBxq3JFR9ENutgqGw/formResponse';
    // Códigos das perguntas do Google Form (nome, e-mail, telefone e motivo)
    var ENTRY = { name: 'entry.682636224', mail: 'entry.1382003374', phone: 'entry.997714580', msg: 'entry.1761479786' };
    var form = document.getElementById('contactForm'), out = document.getElementById('contactMsg');
    var btn = form.querySelector('button[type=submit]'), busy = false, fallback = document.getElementById('contactFallback');
    var spin = btn.querySelector('.send-spin'), btnLabel = btn.querySelector('.send-label');
    function say(t, bad) {
      out.textContent = t; out.classList.toggle('text-accent', !bad); out.classList.toggle('text-[#ff6b6b]', !!bad);
      out.classList.remove('say-in'); void out.offsetWidth; out.classList.add('say-in');
    }
    function wrong(el, msg) {
      el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', 'contactMsg');
      el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake');
      say(msg, true); el.focus();
    }
    [].forEach.call(form.querySelectorAll('input, textarea'), function (el) {
      el.addEventListener('input', function () { el.removeAttribute('aria-invalid'); });
    });
    function sending(on) {
      busy = on; btn.disabled = on; spin.classList.toggle('hidden', !on);
      btnLabel.textContent = on ? 'Enviando…' : 'Enviar mensagem →';
    }
    // máscara do telefone: (00) 00000-0000 ou (00) 0000-0000
    form['c-phone'].addEventListener('input', function () {
      var d = this.value.replace(/\D/g, '').slice(0, 11), o = d;
      if (d.length > 2) o = '(' + d.slice(0, 2) + ') ' + d.slice(2);
      if (d.length > 6) o = '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length - 4) + '-' + d.slice(-4);
      this.value = o;
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault(); if (busy) return;
      var v = { name: form['c-name'].value.trim(), mail: form['c-mail'].value.trim(), phone: form['c-phone'].value.trim(), msg: form['c-msg'].value.trim() };
      var digits = v.phone.replace(/\D/g, '');
      if (!v.name) return wrong(form['c-name'], 'Preencha o seu nome.');
      // e-mail válido: regra do próprio navegador (type=email) + domínio com ponto e terminação de 2 letras ou mais
      if (!form['c-mail'].checkValidity() || !/^[^@\s]+@[^@\s.]+(\.[^@\s.]+)*\.[a-z]{2,}$/i.test(v.mail)) return wrong(form['c-mail'], 'Digite um e-mail válido (ex.: voce@exemplo.com).');
      if (digits.length < 10 || digits.length > 13) return wrong(form['c-phone'], 'Digite um telefone válido, com DDD.');
      if (v.msg.length < 10) return wrong(form['c-msg'], 'Conte um pouco mais sobre o que você precisa.');
      if (!ENTRY.name || !ENTRY.mail || !ENTRY.phone || !ENTRY.msg) { say('Formulário ainda não configurado: faltam os códigos das perguntas.', true); return; }
      var body = new URLSearchParams();
      body.set(ENTRY.name, v.name); body.set(ENTRY.mail, v.mail); body.set(ENTRY.phone, v.phone); body.set(ENTRY.msg, v.msg);
      fallback.classList.add('hidden');
      sending(true); out.textContent = '';
      fetch(FORM_URL, { method: 'POST', mode: 'no-cors', body: body }).then(function () {
        form.reset(); say('✓ Obrigado, ' + v.name + '! Recebi sua mensagem e respondo em breve.');
      }, function () {
        say('O envio direto foi bloqueado neste navegador. Use o botão abaixo: o formulário abre já preenchido, é só enviar.', true);
        fallback.href = FORM_URL.replace('/formResponse', '/viewform') + '?usp=pp_url&' + body.toString();
        fallback.classList.remove('hidden');
      }).then(function () { sending(false); });
    });
  })();
</script>
<style is:global>
  #contactForm input, #contactForm textarea { transition: border-color .2s; }
  #contactForm input:focus-visible, #contactForm textarea:focus-visible { border-color: var(--accent); }
  #contactForm [aria-invalid="true"], #contactForm [aria-invalid="true"]:focus-visible { border-color: #ff6b6b; outline-color: #ff6b6b; }
  .shake { animation: shake .32s cubic-bezier(.36, .07, .19, .97); }
  @keyframes shake { 20%, 60% { transform: translateX(-5px); } 40%, 80% { transform: translateX(5px); } }
  .send-spin:not(.hidden) { animation: send-spin .7s linear infinite; }
  @keyframes send-spin { to { transform: rotate(360deg); } }
  .say-in { animation: say-in .3s ease-out; }
  @keyframes say-in { from { opacity: 0; transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .shake, .say-in { animation: none; } .send-spin:not(.hidden) { animation-duration: 2s; } }
</style>
