---
// Botão fixo "Voltar à cidade" dos sites de demonstração. As cores vêm da marca de cada site (via class).
interface Props { class?: string; }
const { class: extra = '' } = Astro.props;
---
<button class:list={['fixed bottom-4 left-4 z-50 inline-flex cursor-pointer leading-[normal] items-center gap-2 rounded-full border-0 px-4 py-2.5 text-[14px] shadow-[0_8px_24px_rgba(0,0,0,0.3)] hover:bg-black', extra]} type="button" id="back" aria-label="Voltar para a cidade">← Voltar à cidade</button>
<script is:inline>
  document.getElementById('back').addEventListener('click', () => {
    if (document.referrer && history.length > 1) history.back();
    else location.href = '../';
  });
</script>
