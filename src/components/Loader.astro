---
// Tela de carregamento: aparece só na primeira visita da sessão (index.astro marca html.loading) e cobre a página
// até a foto do hero carregar (mínimo 0,8 s, máximo 2 s). Antes esperava a cidade 3D, que agora só carrega quando a pessoa navega.
// A cidade (iframe ?hold=1) avisa com { type: 'city:loaded' } e a página responde { type: 'city:start' } para a animação
// de entrada; se a cidade carregar depois (ela só carrega perto da tela), a animação começa quando ela ficar pronta.
// Quando a tela escurecida some, a cobra fica um instante, é arremessada para cima e cai para a esquerda (parábola).
// Fundo: imagem com "HALLAN" repetido em diagonal (img/loader-hallan.webp), cobrindo a largura e subindo reto a 15 px/s, uma vez só
// (a imagem não emenda consigo mesma, e o loader dura no máximo ~3 s). A tela some em 0,6 s.
// Ao terminar, a tela e a cobra são removidas da página, para não ficarem animando escondidas.
---
<div class="loader fixed inset-0 z-100 overflow-hidden bg-black" id="loader" role="status" aria-live="polite" aria-label="Carregando">
  <div class="loader-bg" aria-hidden="true"></div>
</div>
<div class="fixed inset-0 z-101 grid place-items-center overflow-hidden pointer-events-none" id="ouroWrap" aria-hidden="true">
  <div id="ouro"><div class="loader-ouro"></div></div>
</div>
<style is:global>
  .loader { transition: opacity .6s ease, visibility 0s linear .6s; }
  html:not(.loading) .loader { opacity: 0; visibility: hidden; pointer-events: none; }
  .loader { background: #000; }
  /* as imagens do loader são fundos aplicados só com html.intro (primeira visita): nas repetidas nem são baixadas */
  .loader-bg { position: absolute; top: 0; left: 0; width: 100%; aspect-ratio: 800 / 3600; background: center top / 100% auto no-repeat; animation: loader-rise 10s linear forwards; will-change: transform; }
  html.intro.hero-ok .loader-bg { background-image: url(img/loader-hallan.webp); }
  html.intro.hero-ok .loader-ouro { background-image: url(img/ouroboros.webp); }
  @keyframes loader-rise { to { transform: translateY(-150px); } }
  .loader-ouro { width: 23vmin; height: 23vmin; background: center / contain no-repeat; animation: loader-spin 6s linear infinite; }
  @keyframes loader-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .loader { transition: none; }
    .loader-bg { animation: none; }
    .loader-ouro { animation-duration: 24s; }
  }
</style>
<script is:inline>
  (function () {
    var root = document.documentElement;
    function cityFrame() { return document.getElementById('cityFrame'); }   // o iframe vem depois deste script
    var shownAt = Date.now(), MIN_MS = 1600, MAX_MS = 2600, done = false;
    var HOLD_MS = 300, TOSS_MS = 1700;
    function toss() {
      var wrap = document.getElementById('ouroWrap'), box = document.getElementById('ouro'), img = box.firstElementChild;
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var end = function () { wrap.remove(); };   // terminou: tira a cobra da página (nada fica animando escondido)
      if (reduce || !box.animate) { end(); return; }
      var a0 = 0, an = img.getAnimations && img.getAnimations()[0];
      if (an) a0 = ((an.currentTime % 6000) / 6000) * 360;
      img.style.animation = 'none';
      var W = innerWidth, H = innerHeight, a1 = -540, kf = [], N = 48;   // gira no sentido anti-horário e termina apontando para a esquerda
      for (var i = 0; i <= N; i++) {
        var t = i / N, x = -0.72 * W * t, y = (-1.2 * t + 1.8 * t * t) * H, r = a0 + (a1 - a0) * (1 - Math.pow(1 - t, 2));
        kf.push({ transform: 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px) rotate(' + r.toFixed(1) + 'deg)', offset: t });
      }
      box.style.transform = kf[0].transform;
      var anim = box.animate(kf, { duration: TOSS_MS, easing: 'linear', fill: 'forwards' });
      anim.onfinish = end; anim.oncancel = end;
    }
    function startCity() { try { cityFrame().contentWindow.postMessage({ type: 'city:start' }, '*'); } catch (e) {} }
    // visita repetida na sessão: sem tela de carregamento nem cobra
    if (!root.classList.contains('loading')) {
      done = true;
      var l0 = document.getElementById('loader'), w0 = document.getElementById('ouroWrap');
      if (l0) l0.remove(); if (w0) w0.remove();
    }
    function finish() {
      if (done) return; done = true;
      root.classList.remove('loading');
      setTimeout(function () { var l = document.getElementById('loader'); if (l) l.remove(); }, 800);   // depois do fade, a tela sai da página
      setTimeout(toss, HOLD_MS);
      startCity();
    }
    function finishSoon() { setTimeout(finish, Math.max(0, MIN_MS - (Date.now() - shownAt))); }
    window.addEventListener('message', function (e) {
      var frame = cityFrame();
      if (!frame || e.source !== frame.contentWindow || !e.data || e.data.type !== 'city:loaded') return;
      if (done) startCity(); else finishSoon();   // a cidade carregou depois que a tela já saiu: anima agora
    });
    // A cidade agora só carrega quando a pessoa começa a navegar, então a tela não espera por ela: sai assim que a foto
    // do hero chegou (html.hero-ok, marcado no <head> da home), respeitando o mínimo de 1,6 s para a animação aparecer.
    if (!done) {
      if (root.classList.contains('hero-ok')) finishSoon();
      else new MutationObserver(function (m, obs) { if (root.classList.contains('hero-ok')) { obs.disconnect(); finishSoon(); } }).observe(root, { attributes: true, attributeFilter: ['class'] });
      setTimeout(finish, MAX_MS);   // limite: depois de 2,6 s a página abre sozinha
    }
  })();
</script>
