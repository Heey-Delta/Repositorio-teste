---
import Media from './Media.astro';
---
<section id="lab" class="border-b border-line" aria-labelledby="lab-title">
  <div class="mx-auto grid min-h-[260px] max-w-[1440px] grid-cols-2 lg:min-h-[340px] lg:grid-cols-[1fr_1.05fr_1fr]">
    <Media label="Textura" alt="Cúpula escura sobre uma cidade em ruínas, em meio-tom preto e branco" src="img/laboratorio.webp" class="relative order-2 border-l border-line lg:order-1 lg:border-r lg:border-l-0" imgClass="grayscale" />
    <div class="order-1 flex flex-col justify-center gap-3 py-7 pr-4 pl-5 lg:gap-[18px] lg:px-12 lg:py-14">
      <h2 id="lab-title" class="font-display text-[clamp(20px,6.4vw,26px)] leading-none uppercase lg:text-[40px]">/ Laboratório<br>Experimental</h2>
      <p class="text-[13px] text-muted lg:max-w-[280px] lg:text-[15px]">Um espaço para experimentação criativa, onde as ideias vão além dos limites.</p>
      <a href="lab/" class="link-ui self-start text-[11px] lg:text-xs">Explorar o laboratório →</a>
    </div>
    <Media label="Forma líquida abstrata" alt="Baterista tocando em um estúdio, em preto e branco" src="img/laboratorio-2.webp" class="relative order-3 hidden border-l border-line lg:flex" imgClass="grayscale object-[60%_center]" />
  </div>
</section>
