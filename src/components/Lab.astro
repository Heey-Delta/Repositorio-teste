---
import Media from './Media.astro';
---
<section id="lab" class="border-b border-line" aria-labelledby="lab-title">
  <div class="mx-auto grid min-h-[260px] max-w-[1440px] grid-cols-2 lg:min-h-[340px] lg:grid-cols-[1fr_1.05fr_1fr]">
    <Media label="Texture" class="relative hidden border-r border-line lg:flex" />
    <div class="flex flex-col justify-center gap-3 py-7 pr-4 pl-5 lg:gap-[18px] lg:px-12 lg:py-14">
      <h2 id="lab-title" class="font-display text-[28px] leading-none uppercase lg:text-[40px]">/ Experimental<br>Lab</h2>
      <p class="text-[13px] text-muted lg:max-w-[280px] lg:text-[15px]">A space for creative experimentation, where ideas go beyond the limits.</p>
      <a href="#contact" class="link-ui self-start text-[11px] lg:text-xs">Explore lab →</a>
    </div>
    <Media label="Abstract liquid shape" class="relative border-l border-line">
      <span class="absolute bottom-0 left-0 size-12 bg-lime lg:right-0 lg:left-auto lg:size-14" aria-hidden="true"></span>
    </Media>
  </div>
</section>
