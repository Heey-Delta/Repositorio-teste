---
// Processo: uma apresentação (o mesmo bloco de slides do Lab, src/lib/rich-blocks.ts) com as 5 etapas.
// Cada slide tem o número, o nome, uma frase e a figura da etapa (public/img/proc-*.webp, brancas em fundo transparente).
// Embaixo da apresentação, um texto explica a etapa que está na tela e muda junto com o slide.
import { slidesHtml, type Deck } from '../lib/rich-blocks';
const steps = [
  { name: 'Descoberta', icon: 'descoberta', line: 'Entendo o seu negócio, quem compra de você e o que o site precisa resolver.',
    text: 'Começamos com uma conversa. Você me conta o que vende, para quem e onde as coisas estão travando. Eu estudo os concorrentes e o que já existe, e definimos juntos o objetivo principal do site: vender, receber contatos ou apresentar a marca.' },
  { name: 'Estratégia', icon: 'estrategia', line: 'Estrutura e texto vêm antes de qualquer cor.',
    text: 'Monto o mapa das páginas e escrevo a mensagem de cada uma. É aqui que a página aprende a dizer em 5 segundos o que você faz. Você aprova a estrutura antes de eu começar a desenhar.' },
  { name: 'Design', icon: 'design', line: 'O visual nasce no Figma, primeiro pensado para o celular.',
    text: 'Com a estrutura aprovada, crio o layout com a identidade da sua marca: tipografia, cores, imagens e os detalhes de interação. Você vê as telas, comenta e ajustamos juntos até ficar certo.' },
  { name: 'Desenvolvimento', icon: 'desenvolvimento', line: 'O layout vira um site rápido, leve e fácil de achar no Google.',
    text: 'Programo o site com Astro, Tailwind e JavaScript, cuidando de velocidade, acessibilidade e SEO. Testo em celulares e computadores diferentes antes de mostrar a versão final.' },
  { name: 'Lançamento', icon: 'lancamento', line: 'O site vai ao ar, pronto para crescer.',
    text: 'Publico o site no seu domínio, conecto as ferramentas de análise e mostro como atualizar o conteúdo. Depois do lançamento, combinamos os próximos passos.' },
];
const n = steps.length;
const deck: Deck = {
  ratio: '16:9',
  slides: steps.map((st, i) => ({
    id: `proc-${i + 1}`, bg: '#000000',
    items: [
      { id: `p${i}n`, type: 'text', text: `${String(i + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`, size: 2.8, color: '#FBBF00', x: 7, y: 11, w: 40, h: 8 },
      { id: `p${i}t`, type: 'title', text: st.name, size: i === 3 ? 6.4 : 8, color: i === n - 1 ? '#FBBF00' : '#F2F2EE', x: 7, y: 24, w: 56, h: 26 },
      { id: `p${i}l`, type: 'text', text: st.line, size: 3.6, color: '#A6A6A0', x: 7, y: 54, w: 52, h: 36 },
      { id: `p${i}i`, type: 'image', src: `/img/proc-${st.icon}.webp`, alt: '', x: 70, y: 28, w: 20, h: 44 },
    ],
  })),
};
---
<section id="process" class="border-b border-line bg-surface" aria-labelledby="process-title">
  <div class="wrap grid gap-6 py-8 lg:grid-cols-[1fr_2fr] lg:items-start lg:gap-16 lg:py-16">
    <div class="flex flex-col gap-3.5 lg:gap-5">
      <h2 id="process-title" class="font-display text-[32px] leading-none uppercase lg:text-5xl">/Processo</h2>
      <p class="text-[13px] text-muted lg:max-w-[260px] lg:text-[15px]">Do primeiro papo ao site no ar, em cinco etapas. Passe os slides para ver cada uma.</p>
    </div>
    <div class="proc-deck flex min-w-0 flex-col gap-4">
      <Fragment set:html={slidesHtml({ deck: JSON.stringify(deck), width: '', align: 'center' })} />
      <div class="min-h-[120px] border-l-2 border-accent pl-4 lg:pl-6" aria-live="polite">
        <p id="procName" class="label-ui m-0 mb-2 text-[11px] text-muted tabular-nums">01 · {steps[0].name}</p>
        <p id="procText" class="m-0 max-w-[640px] text-[15px] lg:text-[17px]">{steps[0].text}</p>
      </div>
    </div>
  </div>
</section>
<style is:global>
  .proc-deck .lab-deck { width: 100% !important; max-width: none !important; margin: 0 !important; border-radius: 24px; overflow: hidden; background: #000; }
  .proc-deck .lab-si-img { object-fit: contain; }
</style>
<script is:inline define:vars={{ steps: steps.map((s) => ({ name: s.name, text: s.text })) }}>
  (function () {
    var deck = document.querySelector('#process [data-deck]'); if (!deck) return;
    var track = deck.querySelector('.lab-deck-track'), count = deck.querySelector('[data-deck-count]'), total = track.children.length;
    var name = document.getElementById('procName'), text = document.getElementById('procText'), cur = 0;
    function at() { return Math.round(track.scrollLeft / Math.max(1, track.clientWidth)); }
    function go(i) { track.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * track.clientWidth, behavior: 'smooth' }); }
    function sync() {
      var i = at(); if (count) count.textContent = (i + 1) + ' / ' + total;
      if (i === cur) return; cur = i;
      name.textContent = String(i + 1).padStart(2, '0') + ' · ' + steps[i].name;
      text.textContent = steps[i].text;
    }
    var p = deck.querySelector('[data-deck-prev]'), n = deck.querySelector('[data-deck-next]');
    if (p) p.addEventListener('click', function () { go(at() - 1); });
    if (n) n.addEventListener('click', function () { go(at() + 1); });
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); } });
  })();
</script>
