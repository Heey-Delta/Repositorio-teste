---
// Dúvidas frequentes: respostas curtas para o que as pessoas perguntam antes de contratar.
// As mesmas perguntas vão para os dados estruturados (FAQPage) em src/pages/index.astro.
import { faq } from '../lib/site';
---
<section id="faq" class="border-b border-line" aria-labelledby="faq-title">
  <div class="wrap grid gap-6 py-8 lg:grid-cols-[1fr_2fr] lg:gap-16 lg:py-16">
    <div class="rv flex flex-col gap-3.5 lg:gap-5">
      <h2 id="faq-title" class="font-display text-[32px] leading-none uppercase lg:text-5xl">/Dúvidas</h2>
      <p class="text-[13px] text-muted lg:max-w-[280px] lg:text-[15px]">As perguntas que mais escuto antes de começar um projeto. Se a sua não estiver aqui, é só me chamar.</p>
    </div>
    <div class="rv flex flex-col border-t border-line">
      {faq.map((f) => (
        <details class="faq group border-b border-line">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-bold hover:text-accent lg:py-5 lg:text-[17px] [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="faq-plus grid size-8 shrink-0 place-items-center rounded-full border border-line text-muted group-open:rotate-180 group-open:border-accent group-open:text-accent" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
          </summary>
          <div class="faq-body"><p class="m-0 max-w-[640px] pb-5 text-[14px] text-muted lg:text-[15px]">{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style is:global>
  .faq-plus { transition: transform .35s cubic-bezier(.2, .8, .2, 1), border-color .25s ease, color .25s ease; }
  /* abre e fecha deslizando (navegadores com interpolate-size); nos outros, abre direto */
  .faq { interpolate-size: allow-keywords; }
  .faq::details-content { block-size: 0; overflow: hidden; transition: block-size .4s cubic-bezier(.2, .8, .2, 1), content-visibility .4s allow-discrete; }
  .faq[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: reduce) { .faq-plus, .faq::details-content { transition: none; } }
</style>
