---
// Editor de publicação: a página tem o mesmo visual do artigo público e é editada ali mesmo
// (título, resumo e corpo). Os metadados ficam na gaveta "Detalhes". O comportamento está em src/scripts/editor.ts.
import '../../styles/global.css';
import Base from '../../layouts/Base.astro';
import type { PostDraft } from '../../lib/posts';
import { statusLabel } from '../../lib/admin';
import Tool from './EditorTool.astro';

interface Option { id: number; name: string; slug: string }
interface Props {
  id: string | null;
  draft: PostDraft;
  updatedAt: string | null;
  login: string;
  options: { departments: (Option & { code: string })[]; contentTypes: Option[]; areas: (Option & { about: string })[]; posts: { id: string; code: string | null; title: string; status: keyof typeof statusLabel }[] };
  revisions: { id: number; login: string; note: string | null; createdAt: Date }[];
  cover: { id: string; url: string; alt: string | null; width: number | null; height: number | null } | null;
  attachments: { id: string; url: string; alt: string | null; caption: string | null; size: number; width: number | null; height: number | null }[];
}
const { id, draft, updatedAt, login, options, revisions, cover, attachments } = Astro.props;
const dep = options.departments.find((d) => d.id === draft.departmentId) ?? options.departments[0];
const data = JSON.stringify({ id, draft, updatedAt, login, cover, attachments, areas: options.areas, contentTypes: options.contentTypes, departments: options.departments, posts: options.posts, site: Astro.site?.origin })
  .replace(/</g, '\\u003c');
const stages = { concept: 'Concept · ideia inicial', 'in-progress': 'In progress · em desenvolvimento', active: 'Active · em investigação', completed: 'Completed · concluído', archived: 'Archived · arquivado' };
const levels = ['Introdutório', 'Intermediário', 'Aprofundado'];
const formats = ['Essay', 'Observation', 'Idea', 'Tutorial', 'Opinion'];
const schemaTypes = ['Article', 'TechArticle', 'BlogPosting', 'CreativeWork', 'Report'];
const fmt = (d: Date) => d.toLocaleString('pt-BR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' });
const localInput = (iso: string | null | undefined) => {
  if (!iso) return '';
  const d = new Date(iso), p = (n: number) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
};
const field = 'w-full rounded-[6px] border border-line bg-bg px-3 text-[14px] text-ink focus-visible:border-accent aria-[invalid=true]:border-[#ff5a5a]';
const label = 'flex flex-col gap-1.5 text-[13px] text-muted';
// Barra em abas (como o Word): Início (texto), Inserir (blocos), Layout (página), Regras (formatação da publicação)
// e as abas de contexto Tabela e Bloco, que aparecem só com o cursor numa tabela ou com um bloco selecionado.
type T = [string, string, string];
const homeGroups: [string, T[]][] = [
  ['Histórico', [['undo', 'Desfazer', '↶'], ['redo', 'Refazer', '↷']]],
  ['Estilo', [['h2', 'Título de seção', 'H2'], ['h3', 'Subtítulo', 'H3'], ['h4', 'Subtítulo menor', 'H4']]],
  ['Fonte', [['bold', 'Negrito', 'B'], ['italic', 'Itálico', 'I'], ['underline', 'Sublinhado', 'U'], ['strike', 'Riscado', 'S'], ['sup', 'Sobrescrito', 'x²'], ['sub', 'Subscrito', 'x₂'], ['clear', 'Limpar formatação', 'Limpar']]],
  ['Parágrafo', [['bullet', 'Lista', '•'], ['ordered', 'Lista numerada', '1.'], ['quote', 'Citação', '❝'], ['code', 'Código', '</>'], ['link', 'Link', 'Link']]],
];
const insertGroups: [string, T[]][] = [
  ['Mídia', [['image', 'Imagem', 'Imagem']]],
  ['Dados', [['table', 'Inserir tabela', 'Tabela'], ['sheet', 'Inserir planilha (células com fórmulas)', 'Planilha'], ['chart', 'Inserir gráfico', 'Gráfico'], ['diagram', 'Inserir diagrama (organograma, fluxograma…)', 'Diagrama']]],
  ['Ilustrações', [['shape', 'Inserir forma (retângulo, círculo, seta, estrela…)', 'Forma'], ['math', 'Inserir equação', 'Equação'], ['hr', 'Divisória', 'Divisória']]],
  ['Fontes', [['ref', 'Inserir referência (nome e link; no site vai para a lista numerada do fim)', 'Referência']]],
  ['Apresentação', [['slides', 'Inserir apresentação (slides passáveis dentro do texto)', 'Apresentação']]],
];
const tabs: [string, string, boolean][] = [['inicio', 'Início', false], ['inserir', 'Inserir', false], ['layout', 'Layout', false], ['regras', 'Regras', false], ['tabela', 'Tabela', true], ['bloco', 'Bloco', true]];
// aparecem só com o cursor dentro de uma tabela
const tableGroups: [string, T[]][] = [
  ['Linhas e colunas', [['rowBefore', 'Adicionar linha acima', '+ Linha acima'], ['rowAdd', 'Adicionar linha abaixo', '+ Linha abaixo'], ['colBefore', 'Adicionar coluna à esquerda', '+ Coluna à esquerda'], ['colAdd', 'Adicionar coluna à direita', '+ Coluna à direita'], ['rowDel', 'Remover linha', '− Linha'], ['colDel', 'Remover coluna', '− Coluna']]],
  ['Formato', [['headerRow', 'Primeira linha como cabeçalho', 'Cabeçalho'], ['tableRefs', 'Mostrar letras das colunas e números das linhas', 'Linhas e colunas']]],
  ['Tabela', [['tableSelect', 'Selecionar a tabela inteira', 'Selecionar'], ['tableUp', 'Mover a tabela para cima', 'Subir'], ['tableDown', 'Mover a tabela para baixo', 'Descer'], ['tableDel', 'Apagar tabela', 'Excluir']]],
];
// aparecem com uma forma, gráfico, diagrama, equação ou imagem selecionados
const blockTools = [
  ['blockEdit', 'Editar dados e aparência', 'Editar'], ['alignLeft', 'Alinhar à esquerda', 'Esquerda'], ['alignCenter', 'Centralizar', 'Centro'], ['alignRight', 'Alinhar à direita', 'Direita'],
  ['sizeDown', 'Diminuir', 'Menor'], ['sizeUp', 'Aumentar', 'Maior'], ['sizeReset', 'Largura do texto', 'Largura total'], ['blockDup', 'Duplicar', 'Duplicar'], ['blockDel', 'Excluir', 'Excluir'],
];
const noPressed = ['clear', 'undo', 'redo', 'link'];
---
<Base title={`${draft.title || 'Nova publicação'} · Editor · Admin`} bodyClass="editor-body">
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow"></Fragment>
  <script type="application/json" id="editorData" set:html={data} />

  <header class="sticky top-0 z-40 border-b border-line bg-bg">
    <div class="ed-head flex min-h-14 flex-wrap items-center gap-2 px-4 py-2 lg:gap-3 lg:px-6">
      <a href="/admin/publicacoes/" class="text-sm text-muted hover:text-ink">← Publicações</a>
      <p id="saveState" class="m-0 min-w-0 flex-1 truncate text-[13px] text-muted" role="status" aria-live="polite">{id ? 'Tudo salvo' : 'Ainda não salva'}</p>
      <a id="viewLink" href={`/lab/${dep.slug}/${draft.slug}/`} target="_blank" rel="noopener" hidden={!id || draft.status !== 'published'} class="hidden text-sm text-muted hover:text-ink sm:inline">Ver no site ↗</a>
      <button type="button" id="pseudoBtn" title="Ver, baixar e importar o pseudocódigo; gerar e ler PDF" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Pseudocódigo</button>
      <button type="button" id="previewBtn" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Prévia</button>
      <button type="button" id="detailsBtn" aria-expanded="false" aria-controls="details" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Detalhes</button>
      <button type="button" id="saveBtn" class="min-h-10 cursor-pointer rounded-[6px] bg-accent px-5 text-sm font-bold text-black hover:brightness-110 disabled:cursor-wait disabled:opacity-60">Salvar</button>
    </div>
    <div id="toolbar" class="rb" aria-label="Ferramentas do texto">
      <div class="rb-tabs" role="tablist" aria-label="Grupos de ferramentas">
        {tabs.map(([id, name, ctx]) => (
          <button type="button" role="tab" id={`tab-${id}`} data-tab={id} aria-controls={id === 'tabela' ? 'tableTools' : id === 'bloco' ? 'blockTools' : `panel-${id}`} aria-selected={id === 'inicio' ? 'true' : 'false'} hidden={ctx ? true : undefined} class={ctx ? 'rb-tab rb-ctx' : 'rb-tab'}>{name}</button>
        ))}
        <button type="button" id="rbCollapse" class="rb-collapse" aria-expanded="true" aria-label="Recolher a barra de ferramentas" title="Recolher / mostrar a barra">▴</button>
      </div>
      <div id="panel-inicio" role="tabpanel" aria-labelledby="tab-inicio" class="rb-panel">
        {homeGroups.map(([cap, items]) => (
          <div class="rb-group" role="group" aria-label={cap}>
            <div class="rb-items">{items.map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={!noPressed.includes(cmd)} />)}
              {cap === 'Fonte' && <>
                <label class="rb-field" title="Fonte do trecho selecionado">Fonte
                  <select id="fontFamily"><option value="">Padrão</option><option value="anton">Anton</option><option value="arial">Arial</option><option value="times">Times New Roman</option></select>
                </label>
                <label class="rb-field" title="Cor do texto">Cor<input id="textColor" type="color" value="#fbbf00"></label>
                <label class="rb-field" title="Realce (marca-texto)">Realce<input id="textHighlight" type="color" value="#8a6a00"></label>
              </>}
              {cap === 'Parágrafo' && <label class="rb-field">Alinhar
                <select id="textAlign"><option value="left">Esquerda</option><option value="center">Centro</option><option value="right">Direita</option><option value="justify">Justificar</option></select>
              </label>}
            </div>
            <span class="rb-cap">{cap}</span>
          </div>
        ))}
      </div>
      <div id="panel-inserir" role="tabpanel" aria-labelledby="tab-inserir" class="rb-panel" hidden>
        {insertGroups.map(([cap, items]) => (
          <div class="rb-group" role="group" aria-label={cap}>
            <div class="rb-items">{items.map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={false} big />)}</div>
            <span class="rb-cap">{cap}</span>
          </div>
        ))}
      </div>
      <div id="panel-layout" role="tabpanel" aria-labelledby="tab-layout" class="rb-panel" hidden>
        <div class="rb-group" role="group" aria-label="Página">
          <div class="rb-items">
            <label class="rb-field">Largura<select data-layout="width"><option value="estreita">Estreita</option><option value="normal">Normal</option><option value="larga">Larga</option><option value="total">Total</option></select></label>
            <label class="rb-field">Colunas<select data-layout="columns" data-num><option value="1">1</option><option value="2">2 (no computador)</option></select></label>
          </div>
          <span class="rb-cap">Página</span>
        </div>
        <div class="rb-group" role="group" aria-label="Texto">
          <div class="rb-items">
            <label class="rb-field">Fonte<select data-layout="font"><option value="arial">Arial</option><option value="anton">Anton</option><option value="times">Times New Roman</option></select></label>
            <label class="rb-field">Letra<select data-layout="fontSize" data-num>{[15, 16, 17, 18, 19, 20, 22].map((n) => <option value={n}>{n} px</option>)}</select></label>
            <label class="rb-field">Entrelinha<select data-layout="lineHeight" data-num>{[1.4, 1.5, 1.6, 1.7, 1.85, 2].map((n) => <option value={n}>{String(n).replace('.', ',')}</option>)}</select></label>
          </div>
          <span class="rb-cap">Texto</span>
        </div>
        <div class="rb-group" role="group" aria-label="Parágrafos">
          <div class="rb-items">
            <label class="rb-field">Espaço entre parágrafos<select data-layout="spacing" data-num>{[[0.6, 'Pouco'], [1.1, 'Normal'], [1.6, 'Médio'], [2.2, 'Muito']].map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
            <label class="rb-field">Alinhamento do texto<select data-layout="align"><option value="left">Esquerda</option><option value="justify">Justificado</option></select></label>
          </div>
          <span class="rb-cap">Parágrafos</span>
        </div>
        <div class="rb-group" role="group" aria-label="Padrão">
          <div class="rb-items"><button type="button" class="tool" data-layout-reset="layout">Restaurar layout</button></div>
          <span class="rb-cap">Padrão</span>
        </div>
      </div>
      <div id="panel-regras" role="tabpanel" aria-labelledby="tab-regras" class="rb-panel" hidden>
        <div class="rb-group" role="group" aria-label="Títulos">
          <div class="rb-items">
            <label class="rb-field">Fonte dos títulos<select data-layout="headingFont"><option value="anton">Anton</option><option value="arial">Arial</option><option value="times">Times New Roman</option></select></label>
            <label class="rb-field">Tamanho<select data-layout="h2Size" data-num>{[24, 28, 30, 34, 40, 48].map((n) => <option value={n}>{n} px</option>)}</select></label>
            <label class="rb-field">Cor H2<input type="color" data-layout="h2Color"></label>
            <label class="rb-field">Cor H3<input type="color" data-layout="h3Color"></label>
            <label class="rb-check"><input type="checkbox" data-layout="numberHeadings">Numerar (1, 1.1)</label>
          </div>
          <span class="rb-cap">Títulos</span>
        </div>
        <div class="rb-group" role="group" aria-label="Texto">
          <div class="rb-items">
            <label class="rb-field">Links<input type="color" data-layout="linkColor"></label>
            <label class="rb-field">Negrito<input type="color" data-layout="boldColor"></label>
            <label class="rb-field">Citações<input type="color" data-layout="quoteColor"></label>
            <label class="rb-check"><input type="checkbox" data-layout="dropCap">Letra capitular</label>
            <label class="rb-check"><input type="checkbox" data-layout="indent">Recuo na 1ª linha</label>
          </div>
          <span class="rb-cap">Texto</span>
        </div>
        <div class="rb-group" role="group" aria-label="Tabelas e imagens">
          <div class="rb-items">
            <label class="rb-check"><input type="checkbox" data-layout="zebra">Tabelas listradas</label>
            <label class="rb-check"><input type="checkbox" data-layout="imageBorder">Borda em imagens e gráficos</label>
          </div>
          <span class="rb-cap">Tabelas e imagens</span>
        </div>
        <div class="rb-group" role="group" aria-label="Padrão">
          <div class="rb-items"><button type="button" class="tool" data-layout-reset="regras">Restaurar regras</button></div>
          <span class="rb-cap">Padrão</span>
        </div>
      </div>
      <div id="tableTools" role="tabpanel" aria-labelledby="tab-tabela" class="rb-panel" hidden>
        {tableGroups.map(([cap, items]) => (
          <div class="rb-group" role="group" aria-label={cap}>
            <div class="rb-items">{items.map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={false} />)}</div>
            <span class="rb-cap">{cap}</span>
          </div>
        ))}
      </div>
      <div id="blockTools" role="tabpanel" aria-labelledby="tab-bloco" class="rb-panel" hidden>
        <div class="rb-group" role="group" aria-label="Aparência">
          <div class="rb-items">
            <label id="blockTypeWrap" class="rb-field">Tipo<select id="blockType"></select></label>
            <label id="blockColorWrap" class="rb-field">Cor<input id="blockColor" type="color"></label>
            {blockTools.slice(0, 1).map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={false} />)}
          </div>
          <span class="rb-cap">Aparência</span>
        </div>
        <div class="rb-group" role="group" aria-label="Posição e tamanho">
          <div class="rb-items">{blockTools.slice(1, 7).map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={false} />)}</div>
          <span class="rb-cap">Posição e tamanho</span>
        </div>
        <div class="rb-group" role="group" aria-label="Bloco">
          <div class="rb-items">{blockTools.slice(7).map(([cmd, name, glyph]) => <Tool cmd={cmd} name={name} glyph={glyph} pressed={false} />)}</div>
          <span class="rb-cap">Bloco</span>
        </div>
      </div>
    </div>
    <div id="tablePicker" hidden role="dialog" aria-label="Tamanho da tabela" class="absolute z-50 rounded-[8px] border border-line bg-bg p-3 shadow-[0_8px_24px_rgb(0_0_0/.6)]">
      <p id="tablePickerLabel" class="m-0 mb-2 text-[13px] text-muted">Escolha linhas × colunas</p>
      <div id="tableGrid" class="grid gap-[3px]" style="grid-template-columns:repeat(10,18px)"></div>
      <div class="mt-3 flex items-end gap-2 border-t border-line pt-3">
        <label class="flex flex-col gap-1 text-[12px] text-muted">Linhas<input id="tableRows" type="number" min="1" max="100" value="3" class="h-9 w-16 rounded-[4px] border border-line bg-bg px-2 text-[13px] text-ink"></label>
        <label class="flex flex-col gap-1 text-[12px] text-muted">Colunas<input id="tableCols" type="number" min="1" max="20" value="3" class="h-9 w-16 rounded-[4px] border border-line bg-bg px-2 text-[13px] text-ink"></label>
        <label class="flex min-h-9 items-center gap-1.5 text-[12px] text-muted"><input id="tableHeader" type="checkbox" checked class="size-4 accent-[var(--accent)]">Cabeçalho</label>
        <button type="button" id="tableInsert" class="ml-auto min-h-9 cursor-pointer rounded-[6px] bg-accent px-3 text-[13px] font-bold text-black hover:brightness-110">Inserir</button>
      </div>
    </div>
  </header>

  <div id="page" class="editor-page">
    <article class="pb-24">
      <header class="border-b border-line">
        <div class="wrap flex flex-col gap-5 py-8 lg:py-12">
          <p class="label-ui m-0 text-[11px] text-muted"><span id="depLabel">{dep.name}</span> · <span id="codeLabel">{draft.code ?? 'sem código'}</span></p>
          <h1 id="title" contenteditable="plaintext-only" spellcheck="true" data-placeholder="Título da publicação" aria-label="Título"
            class="editable m-0 max-w-[980px] font-display text-[clamp(40px,11vw,56px)] leading-[0.98] uppercase lg:text-[80px]">{draft.title}</h1>
          <div class="flex max-w-[680px] flex-col gap-1.5">
            <p id="summary" contenteditable="plaintext-only" spellcheck="true" data-placeholder="Resumo em uma ou duas frases. Vira a descrição no Google." aria-label="Resumo"
              class="editable m-0 text-base text-muted lg:text-lg">{draft.summary}</p>
            <p class="m-0 text-xs text-muted tabular-nums"><span id="summaryCount">0</span> / 160 caracteres</p>
          </div>
          <p class="m-0 text-sm">Por <strong>Hallan</strong></p>
        </div>
        <div id="coverBox" class="cover-box mx-auto max-w-[1440px]"></div>
      </header>
      <div class="wrap py-10 lg:py-14">
        <div id="body" class="lab-prose max-w-[720px]" aria-label="Corpo da publicação"></div>
      </div>
    </article>
  </div>

  <aside id="details" aria-label="Detalhes da publicação" class="details fixed top-0 right-0 bottom-0 z-50 flex w-full flex-col border-l border-line bg-bg sm:w-[400px]">
    <div class="flex h-14 shrink-0 items-center justify-between border-b border-line px-5">
      <h2 class="m-0 text-base font-bold">Detalhes</h2>
      <button type="button" id="detailsClose" class="grid size-10 cursor-pointer place-items-center rounded-[6px] hover:bg-[#141414]" aria-label="Fechar detalhes">✕</button>
    </div>
    <form id="meta" class="flex flex-1 flex-col gap-8 overflow-y-auto px-5 py-6" novalidate>
      <fieldset class="m-0 flex flex-col gap-4 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Publicação</legend>
        <label class={label}>Status
          <select name="status" class={`${field} h-11`}>
            {Object.entries(statusLabel).map(([k, v]) => <option value={k} selected={k === draft.status}>{v}</option>)}
          </select>
        </label>
        <label class={label} id="scheduledWrap" hidden={draft.status !== 'scheduled'}>Publicar em
          <input type="datetime-local" name="scheduledAt" value={localInput(draft.scheduledAt)} class={`${field} h-11`}>
        </label>
        <label class={label}>Responsável
          <input name="responsible" value={draft.responsible ?? login} autocomplete="off" class={`${field} h-11`}>
          <span class="text-xs">Quem cuida desta publicação na fila de produção.</span>
        </label>
        <label class={label}>Departamento
          <select name="departmentId" class={`${field} h-11`}>
            {options.departments.map((d) => <option value={d.id} selected={d.id === draft.departmentId}>{d.name}</option>)}
          </select>
        </label>
        <label class={label}>Tipo de conteúdo
          <select name="contentTypeId" class={`${field} h-11`}>
            <option value="">Sem tipo</option>
            {options.contentTypes.map((t) => <option value={t.id} selected={t.id === draft.contentTypeId}>{t.name}</option>)}
          </select>
        </label>
        <div class={label}>
          <label for="f-code">Código editorial</label>
          <div class="flex gap-2">
            <input id="f-code" name="code" value={draft.code ?? ''} placeholder="EXP-001" autocomplete="off" class={`${field} h-11 font-mono uppercase tabular-nums`}>
            <button type="button" id="genCode" class="min-h-11 shrink-0 cursor-pointer rounded-[6px] border border-line px-3 text-[13px] text-ink hover:border-ink">Gerar</button>
          </div>
        </div>
        <label class={label}>Endereço
          <input name="slug" value={draft.slug} autocomplete="off" spellcheck="false" class={`${field} h-11 font-mono text-[13px]`}>
          <span class="text-xs">Se já estiver no ar, o endereço antigo continua funcionando e leva para o novo.</span>
          <span class="text-xs break-all"><span id="slugPrefix">/lab/{dep.slug}/</span><span id="slugEcho" class="text-ink">{draft.slug}</span>/</span>
        </label>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-4 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Classificação</legend>
        <label class={label}>Estágio
          <select name="stage" class={`${field} h-11`}>{Object.entries(stages).map(([k, v]) => <option value={k} selected={k === draft.stage}>{v}</option>)}</select>
        </label>
        <label class={label}>Nível
          <select name="level" class={`${field} h-11`}>{levels.map((l) => <option selected={l === draft.level}>{l}</option>)}</select>
        </label>
        <label class={label} id="formatWrap" hidden={dep.slug !== 'field-notes'}>Formato (Field Notes)
          <select name="format" class={`${field} h-11`}>
            <option value="">Sem formato</option>
            {formats.map((f) => <option selected={f === draft.format}>{f}</option>)}
          </select>
        </label>
        <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
          <legend class="mb-1.5 text-[13px] text-muted">Assuntos</legend>
          {options.areas.map((a) => (
            <label class="flex min-h-9 cursor-pointer items-center gap-3 text-[14px]" title={a.about}>
              <input type="checkbox" name="areaIds" value={a.id} checked={draft.areaIds.includes(a.id)} class="size-4 accent-[var(--accent)]">{a.name}
            </label>
          ))}
        </fieldset>
        <label class={label}>Tags <span class="text-xs">separadas por vírgula</span>
          <input name="tags" value={draft.tags.join(', ')} autocomplete="off" class={`${field} h-11`}>
        </label>
        <label class={label}>Projeto do portfólio relacionado
          <input name="relatedProject" value={draft.relatedProject ?? ''} placeholder="ex.: cidade-isometrica" autocomplete="off" class={`${field} h-11`}>
        </label>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-4 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Transparência</legend>
        <label class={label}>Metodologia
          <textarea name="methodology" rows="3" class={`${field} py-2`} placeholder="Como foi feito, com que fontes e testes.">{draft.methodology ?? ''}</textarea>
        </label>
        <label class={label}>Uso de IA
          <textarea name="aiAssistance" rows="2" class={`${field} py-2`} placeholder="Se houve, em que parte. Deixe vazio se não houve.">{draft.aiAssistance ?? ''}</textarea>
        </label>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Referências</legend>
        <p class="m-0 text-xs text-muted">Aparecem numeradas no fim da publicação, nesta ordem.</p>
        <ol id="refList" class="m-0 flex list-none flex-col gap-3 p-0"></ol>
        <button type="button" id="addRef" class="min-h-10 cursor-pointer self-start rounded-[6px] border border-line px-4 text-[13px] hover:border-ink">+ Adicionar referência</button>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Anexos</legend>
        <p class="m-0 text-xs text-muted">PDFs para baixar no fim da publicação (relatórios, apresentações, documentos).</p>
        <ul id="attList" class="m-0 flex list-none flex-col p-0"></ul>
        <button type="button" id="addAtt" class="min-h-10 cursor-pointer self-start rounded-[6px] border border-line px-4 text-[13px] hover:border-ink">+ Anexar PDF</button>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Publicações relacionadas</legend>
        <p class="m-0 text-xs text-muted">Aparecem em "Continua em" nas duas publicações.</p>
        <ul id="relList" class="m-0 flex list-none flex-col p-0"></ul>
        <div class="flex gap-2">
          <label for="relPick" class="sr-only">Escolher publicação relacionada</label>
          <select id="relPick" class={`${field} h-11 min-w-0 flex-1`}>
            <option value="">Escolher publicação…</option>
            {options.posts.filter((p) => p.id !== id).map((p) => <option value={p.id}>{[p.code, p.title || 'Sem título'].filter(Boolean).join(' · ')}{p.status !== 'published' ? ` (${statusLabel[p.status].toLowerCase()})` : ''}</option>)}
          </select>
          <button type="button" id="addRel" class="min-h-11 shrink-0 cursor-pointer rounded-[6px] border border-line px-3 text-[13px] hover:border-ink">Adicionar</button>
        </div>
      </fieldset>

      <fieldset class="m-0 flex flex-col gap-4 border-0 p-0">
        <legend class="label-ui mb-1 text-[11px] text-muted">Google e compartilhamento</legend>
        <div class="flex flex-col gap-1 rounded-[8px] border border-line p-4" aria-label="Prévia no Google">
          <span id="serpUrl" class="truncate text-xs text-muted"></span>
          <span id="serpTitle" class="text-[17px] leading-snug text-[#8ab4f8]"></span>
          <span id="serpDesc" class="text-[13px] leading-snug text-muted"></span>
        </div>
        <label class={label}>Título no Google <span class="text-xs tabular-nums"><span id="metaTitleCount">0</span> / 60</span>
          <input name="metaTitle" value={draft.seo.metaTitle ?? ''} placeholder="Vazio: usa o título" class={`${field} h-11`}>
        </label>
        <label class={label}>Descrição no Google <span class="text-xs tabular-nums"><span id="metaDescCount">0</span> / 160</span>
          <textarea name="metaDescription" rows="3" placeholder="Vazio: usa o resumo" class={`${field} py-2`}>{draft.seo.metaDescription ?? ''}</textarea>
        </label>
        <label class={label}>URL canônica
          <input name="canonicalUrl" type="url" value={draft.seo.canonicalUrl ?? ''} placeholder="Vazio: o próprio endereço" class={`${field} h-11`}>
        </label>
        <label class={label}>Dados estruturados
          <select name="schemaType" class={`${field} h-11`}>
            <option value="">Automático pelo departamento</option>
            {schemaTypes.map((t) => <option selected={t === draft.seo.schemaType}>{t}</option>)}
          </select>
        </label>
        <label class="flex min-h-9 cursor-pointer items-center gap-3 text-[14px]">
          <input type="checkbox" name="noindex" checked={draft.seo.noindex} class="size-4 accent-[var(--accent)]">Não mostrar no Google
        </label>
      </fieldset>

      <section aria-labelledby="revTitle" class="flex flex-col gap-3">
        <h3 id="revTitle" class="label-ui m-0 text-[11px] text-muted">Versões</h3>
        <p id="revEmpty" class="m-0 text-[13px] text-muted" hidden={revisions.length > 0}>As versões aparecem a cada salvamento.</p>
        <ol id="revList" class="m-0 flex list-none flex-col p-0">
          {revisions.map((r, i) => (
            <li data-rev={r.id} class="flex items-center justify-between gap-3 border-t border-line py-2.5 text-[13px] last:border-b">
              <span class="min-w-0"><span class="font-mono text-muted tabular-nums">#{r.id}</span> {fmt(r.createdAt)}{r.note && <span class="text-muted"> · {r.note}</span>}</span>
              {i === 0 ? <span class="shrink-0 text-xs text-muted">atual</span>
                : <span class="flex shrink-0 gap-1">
                    <button type="button" data-compare={r.id} class="cursor-pointer rounded-[4px] px-2 py-1 text-xs text-ink hover:bg-[#141414]">Comparar</button>
                    <button type="button" data-restore={r.id} class="cursor-pointer rounded-[4px] px-2 py-1 text-xs text-ink hover:bg-[#141414]">Restaurar</button>
                  </span>}
            </li>
          ))}
        </ol>
      </section>
      {id && (
        <section aria-labelledby="dupTitle" class="flex flex-col gap-3 border-t border-line pt-6">
          <h3 id="dupTitle" class="label-ui m-0 text-[11px] text-muted">Duplicar</h3>
          <p class="m-0 text-xs text-muted">Cria uma cópia em rascunho, com o próximo código e outro endereço. Bom para usar uma publicação como modelo.</p>
          <button type="button" id="duplicatePost" class="min-h-10 cursor-pointer self-start rounded-[6px] border border-line px-4 text-[13px] hover:border-ink">Duplicar publicação</button>
        </section>
        <section aria-labelledby="dangerTitle" class="flex flex-col gap-3 border-t border-line pt-6">
          <h3 id="dangerTitle" class="label-ui m-0 text-[11px] text-muted">Excluir</h3>
          <p class="m-0 text-xs text-muted">Apaga a publicação, as versões e as ligações. Não dá para desfazer. Para tirar do ar sem apagar, use o status Arquivado.</p>
          <button type="button" id="deletePost" class="min-h-10 cursor-pointer self-start rounded-[6px] border border-[#ff5a5a] px-4 text-[13px] text-[#ff8a8a] hover:bg-[#1a0b0b]">Excluir publicação</button>
        </section>
      )}
    </form>
  </aside>
  <dialog id="mediaDialog" aria-labelledby="mediaTitle" class="media-dialog m-auto w-[min(720px,calc(100%-32px))] rounded-[8px] border border-line bg-bg p-0 text-ink">
    <form id="mediaForm" method="dialog" class="flex max-h-[min(86dvh,760px)] flex-col">
      <div class="flex h-14 shrink-0 items-center justify-between border-b border-line px-5">
        <h2 id="mediaTitle" class="m-0 text-base font-bold">Imagem</h2>
        <button type="button" id="mediaClose" class="grid size-10 cursor-pointer place-items-center rounded-[6px] hover:bg-[#141414]" aria-label="Fechar">✕</button>
      </div>
      <div class="flex flex-1 flex-col gap-5 overflow-y-auto px-5 py-5">
        <label class="media-drop flex min-h-[180px] cursor-pointer flex-col items-center justify-center gap-2 rounded-[8px] border border-dashed border-line p-4 text-center hover:border-ink">
          <img id="mediaPreview" alt="" hidden class="max-h-[240px] w-auto rounded-[4px]">
          <span id="mediaPick" class="text-sm">Escolher imagem do computador <span class="block text-xs text-muted">JPG, PNG, WebP, AVIF ou GIF. O admin reduz e converte para WebP antes de enviar.</span></span>
          <input id="mediaFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" class="sr-only">
        </label>
        <div id="mediaLibWrap" class="flex flex-col gap-2" hidden>
          <p class="m-0 text-[13px] text-muted">Ou use uma imagem já enviada</p>
          <ul id="mediaLib" class="m-0 grid list-none grid-cols-3 gap-2 p-0 sm:grid-cols-5"></ul>
        </div>
        <label class="flex flex-col gap-1.5 text-[13px] text-muted"><span id="mediaAltLabel">Texto alternativo</span> <span id="mediaAltHint" class="text-xs">Obrigatório. Descreva o que a imagem mostra para quem não consegue vê-la.</span>
          <textarea id="mediaAlt" rows="2" maxlength="300" class="rounded-[6px] border border-line bg-bg px-3 py-2 text-[14px] text-ink focus-visible:border-accent aria-[invalid=true]:border-[#ff5a5a]"></textarea>
        </label>
        <label id="mediaCaptionWrap" class="flex flex-col gap-1.5 text-[13px] text-muted">Legenda <span class="text-xs">Opcional: crédito ou origem.</span>
          <input id="mediaCaption" maxlength="500" class="h-11 rounded-[6px] border border-line bg-bg px-3 text-[14px] text-ink focus-visible:border-accent">
        </label>
        <p id="mediaError" role="alert" class="m-0 text-[13px] text-[#ff8a8a]" hidden></p>
      </div>
      <div class="flex shrink-0 items-center justify-end gap-3 border-t border-line px-5 py-3">
        <button type="button" id="mediaCancel" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Cancelar</button>
        <button type="submit" id="mediaOk" class="min-h-10 cursor-pointer rounded-[6px] bg-accent px-5 text-sm font-bold text-black hover:brightness-110 disabled:cursor-wait disabled:opacity-60">Usar imagem</button>
      </div>
    </form>
  </dialog>
  <dialog id="pseudoDialog" aria-labelledby="pseudoTitle" class="media-dialog m-auto w-[min(1040px,calc(100%-24px))] rounded-[8px] border border-line bg-bg p-0 text-ink">
    <div class="flex max-h-[min(92dvh,900px)] flex-col">
      <div class="flex min-h-14 shrink-0 items-center justify-between gap-3 border-b border-line px-5 py-2">
        <h2 id="pseudoTitle" class="m-0 font-display text-2xl leading-none font-normal uppercase">Pseudocódigo</h2>
        <button type="button" id="pseudoClose" class="grid size-10 cursor-pointer place-items-center rounded-[6px] hover:bg-[#141414]" aria-label="Fechar">✕</button>
      </div>
      <div class="flex flex-1 flex-col gap-3 overflow-hidden px-5 py-4">
        <p class="m-0 text-[13px] text-muted">O pseudocódigo descreve a página inteira e é a base das conversões. Edite aqui ou cole o que a sua ferramenta gerou e clique em <strong class="text-ink">Aplicar na página</strong>.</p>
        <textarea id="pseudoText" spellcheck="false" aria-label="Pseudocódigo da página" class="min-h-[50vh] flex-1 resize-none rounded-[6px] border border-line bg-bg p-3 font-mono text-[13px] leading-relaxed text-ink focus-visible:border-accent"></textarea>
        <p id="pseudoMsg" role="status" aria-live="polite" class="m-0 min-h-5 text-[13px] text-muted"></p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2 border-t border-line px-5 py-3">
        <button type="button" id="pseudoReload" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Ler da página</button>
        <button type="button" id="pseudoTxt" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Baixar .txt</button>
        <button type="button" id="pseudoPdf" class="min-h-10 cursor-pointer rounded-[6px] border border-line px-4 text-sm hover:border-ink">Transformar em PDF</button>
        <label class="inline-flex min-h-10 cursor-pointer items-center rounded-[6px] border border-line px-4 text-sm hover:border-ink">Ler PDF…<input id="pseudoPdfIn" type="file" accept="application/pdf" class="sr-only"></label>
        <label class="inline-flex min-h-10 cursor-pointer items-center rounded-[6px] border border-line px-4 text-sm hover:border-ink">Abrir .txt…<input id="pseudoTxtIn" type="file" accept=".txt,text/plain" class="sr-only"></label>
        <button type="button" id="pseudoApply" class="ml-auto min-h-10 cursor-pointer rounded-[6px] bg-accent px-5 text-sm font-bold text-black hover:brightness-110">Aplicar na página</button>
      </div>
    </div>
  </dialog>
  <dialog id="diffDialog" aria-labelledby="diffTitle" class="media-dialog m-auto w-[min(920px,calc(100%-32px))] rounded-[8px] border border-line bg-bg p-0 text-ink">
    <div class="flex max-h-[min(88dvh,820px)] flex-col">
      <div class="flex min-h-14 shrink-0 items-center justify-between gap-3 border-b border-line px-5 py-2">
        <h2 id="diffTitle" class="m-0 text-base font-bold">Comparar versões</h2>
        <button type="button" id="diffClose" class="grid size-10 cursor-pointer place-items-center rounded-[6px] hover:bg-[#141414]" aria-label="Fechar">✕</button>
      </div>
      <div id="diffBody" class="flex flex-1 flex-col gap-6 overflow-y-auto px-5 py-5 text-[14px]"></div>
    </div>
  </dialog>
</Base>

<script>
  import '../../scripts/editor';
</script>

<style is:global>
  .editor-body { --details-w: 400px; }
  .editable { outline: none; border-radius: 4px; }
  .editable:empty::before { content: attr(data-placeholder); color: #5c5c58; pointer-events: none; }
  .editable:focus-visible { box-shadow: 0 0 0 1px var(--line); }
  #body .ProseMirror { outline: none; min-height: 50vh; }
  .lab-prose :where(.ProseMirror > * + *) { margin-top: 1.1em; }
  #body .ProseMirror p.is-editor-empty:first-child::before { content: attr(data-placeholder); color: #5c5c58; float: left; height: 0; pointer-events: none; }
  .tool[aria-pressed="true"] { background: #1c1c1c; color: var(--accent); }
  .details { transform: translateX(100%); visibility: hidden; transition: transform .2s ease, visibility 0s .2s; }
  .details[data-open="true"] { transform: none; visibility: visible; transition: transform .2s ease; }
  @media (min-width: 1280px) {
    .details { top: 0; }
    .editor-body[data-details="true"] .editor-page { padding-right: var(--details-w); }
    .editor-body[data-details="true"] > header { padding-right: var(--details-w); }
  }
  .details.no-anim, .details.no-anim[data-open="true"] { transition: none; }
  @media (prefers-reduced-motion: reduce) { .details, .details[data-open="true"] { transition: none; } }
  #saveState[data-tone="error"] { color: #ff8a8a; }
  .diff-line { white-space: pre-wrap; word-break: break-word; padding: 1px 10px; font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.6; }
  .diff-line[data-op="+"] { background: #0f2a12; color: #c9f5c9; }
  .diff-line[data-op="-"] { background: #2e1010; color: #f5c9c9; text-decoration: line-through; text-decoration-color: rgb(245 201 201 / .4); }
  .diff-line[data-op="…"] { color: var(--muted); }
  .media-dialog::backdrop { background: rgb(0 0 0 / .7); }
  .media-lib-item[aria-pressed="true"] { outline: 2px solid var(--accent); outline-offset: 2px; }
  #body .ProseMirror img { max-width: 100%; height: auto; }
  #body .ProseMirror table { display: table; table-layout: fixed; }
  #body .ProseMirror .selectedCell { background: rgb(251 191 0 / .12); }
  #body .ProseMirror .column-resize-handle { position: absolute; right: -2px; top: 0; bottom: 0; width: 4px; background: var(--accent); pointer-events: none; }
  #body .ProseMirror td, #body .ProseMirror th { position: relative; }
  #body .ProseMirror .rich-block { cursor: pointer; }
  #tableTools[hidden], #blockTools[hidden], #tablePicker[hidden], #blockTools label[hidden], .rb [hidden] { display: none !important; }
  /* barra em abas */
  .rb { border-top: 1px solid var(--line); }
  .rb-tabs { display: flex; gap: 2px; padding: 0 12px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); }
  .rb-tab { min-height: 38px; padding: 0 14px; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); font-size: 13px; cursor: pointer; white-space: nowrap; }
  .rb-tab:hover { color: var(--ink); }
  .rb-tab[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
  .rb-ctx { color: var(--accent); }
  .rb-collapse { margin-left: auto; min-width: 38px; min-height: 38px; border: 0; background: none; color: var(--muted); cursor: pointer; }
  .rb.collapsed .rb-panel { display: none !important; }
  .rb.collapsed .rb-collapse { rotate: 180deg; }
  .rb-panel { display: flex; align-items: stretch; gap: 0; padding: 6px 12px 2px; overflow-x: auto; scrollbar-width: thin; }
  .rb-group { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 0 10px; border-right: 1px solid var(--line); flex: 0 0 auto; }
  .rb-group:last-child { border-right: 0; }
  .rb-items { display: flex; align-items: center; gap: 2px; flex-wrap: nowrap; }
  .rb-cap { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .rb .tool { min-height: 36px; min-width: 36px; padding: 0 8px; border: 0; border-radius: 4px; background: none; color: var(--muted); font-size: 13px; cursor: pointer; white-space: nowrap; }
  .rb .tool:hover { background: #141414; color: var(--ink); }
  .rb .tool[aria-pressed="true"] { background: #1c1c1c; color: var(--accent); }
  .rb .tool-big { min-height: 40px; padding: 0 12px; border: 1px solid var(--line); color: var(--ink); }
  .rb-field { display: flex; align-items: center; gap: 6px; padding: 0 4px; font-size: 13px; color: var(--muted); white-space: nowrap; min-height: 36px; }
  .rb-field select { height: 32px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); color: var(--ink); padding: 0 6px; font-size: 13px; }
  .rb-field input[type=color] { width: 36px; height: 30px; padding: 2px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); cursor: pointer; }
  .rb-check { display: flex; align-items: center; gap: 6px; padding: 0 6px; font-size: 13px; color: var(--ink); white-space: nowrap; min-height: 36px; cursor: pointer; }
  .rb-check input { width: 16px; height: 16px; accent-color: var(--accent); }
  @media (max-width: 640px) {
    .ed-head > a:first-child { font-size: 0; } .ed-head > a:first-child::before { content: '←'; font-size: 18px; }
    .ed-head button { padding-inline: 10px; }
    .ed-head #saveState { order: 9; flex-basis: 100%; font-size: 12px; }
    .ed-head > a:first-child { min-width: 36px; min-height: 40px; display: grid; place-items: center; }
    .rb-group { padding: 0 6px; }
  }
  /* referências da tabela (A, B, C / 1, 2, 3) — só no editor, não vão para o site */
  #body.show-refs .ProseMirror table { counter-reset: tr; margin-top: 1.6em; margin-left: 2em; }
  #body.show-refs .ProseMirror tr { counter-increment: tr; counter-reset: tc; }
  #body.show-refs .ProseMirror td, #body.show-refs .ProseMirror th { counter-increment: tc; }
  #body.show-refs .ProseMirror tr > :first-child::before { content: counter(tr); position: absolute; right: calc(100% + 6px); top: 50%; translate: 0 -50%; font: 11px Arial, sans-serif; color: var(--muted); }
  #body.show-refs .ProseMirror tr:first-child > *::after { content: counter(tc, upper-alpha); position: absolute; left: 50%; bottom: calc(100% + 4px); translate: -50% 0; font: 11px Arial, sans-serif; color: var(--muted); }
  #body .ProseMirror .tableWrapper.ProseMirror-selectednode, #body .ProseMirror table.ProseMirror-selectednode { outline: 2px solid var(--accent); outline-offset: 4px; }
  #tableGrid span { width: 18px; height: 18px; border: 1px solid var(--line); border-radius: 2px; cursor: pointer; }
  #tableGrid span[data-on] { background: rgb(251 191 0 / .35); border-color: var(--accent); }
  #body .ProseMirror .rich-block { position: relative; }
  #body .ProseMirror .rich-block .lab-deck-nav button { cursor: pointer; }
  #body .ProseMirror .rich-frame { position: absolute; pointer-events: none; display: none; }
  #body .ProseMirror .rich-block.ProseMirror-selectednode { outline: none; }
  #body .ProseMirror .rich-block.ProseMirror-selectednode .rich-frame { display: block; outline: 1px solid var(--accent); }
  #body .ProseMirror .rich-handle { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); pointer-events: auto; touch-action: none; }
  #body .ProseMirror .rich-nw { left: 0; top: 0; cursor: nwse-resize; } #body .ProseMirror .rich-n { left: 50%; top: 0; cursor: ns-resize; }
  #body .ProseMirror .rich-ne { left: 100%; top: 0; cursor: nesw-resize; } #body .ProseMirror .rich-e { left: 100%; top: 50%; cursor: ew-resize; }
  #body .ProseMirror .rich-se { left: 100%; top: 100%; cursor: nwse-resize; } #body .ProseMirror .rich-s { left: 50%; top: 100%; cursor: ns-resize; }
  #body .ProseMirror .rich-sw { left: 0; top: 100%; cursor: nesw-resize; } #body .ProseMirror .rich-w { left: 0; top: 50%; cursor: ew-resize; }
  #body .ProseMirror .rich-block.resizing { cursor: grabbing; user-select: none; }
  @media (pointer: coarse) { #body .ProseMirror .rich-handle { width: 20px; height: 20px; margin: -10px 0 0 -10px; } }
  #body .ProseMirror img.ProseMirror-selectednode { outline: 2px solid var(--accent); outline-offset: 2px; }
  #saveState[data-tone="dirty"] { color: var(--ink); }
</style>
