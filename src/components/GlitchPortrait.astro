---
// Glitch do retrato (seção Sobre): em rajadas curtas, faixas horizontais da própria imagem saem do lugar, aparecem cópias
// com separação de cor (ciano e magenta) e um traço na cor de destaque corta a imagem. Ciclo de 5 s, com a rajada principal
// perto do fim e uma menor no meio. Vai dentro do <Media> da imagem; `src` e `position` precisam ser os mesmos da imagem.
// As camadas usam a mesma respiração (about-pulse) da imagem e deslocam com `translate`, que não briga com o `transform`.
interface Props { src: string; position?: string; }
const { src, position = '75% bottom' } = Astro.props;
const bg = `background-image:url(${src}); background-position:${position};`;
---
<div class="gp pointer-events-none absolute inset-0 z-[1] overflow-hidden" aria-hidden="true">
  <div class="gp-l gp-1 about-pulse" style={bg}></div>
  <div class="gp-l gp-2 about-pulse" style={bg}></div>
  <div class="gp-l gp-3 about-pulse" style={bg}></div>
  <div class="gp-l gp-4 about-pulse" style={bg}></div>
  <div class="gp-l gp-cy about-pulse" style={bg}></div>
  <div class="gp-l gp-mg about-pulse" style={bg}></div>
  <div class="gp-line"></div>
</div>
<style is:global>
  .gp { --gp-t: 5s; }
  .gp-l { position: absolute; inset: 0; background-size: cover; background-repeat: no-repeat; will-change: translate, clip-path, opacity; }
  .gp-1 { clip-path: inset(12% 0 80% 0); animation: gp1 var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-2 { clip-path: inset(38% 0 54% 0); filter: contrast(1.4) brightness(1.2); animation: gp2 var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-3 { clip-path: inset(61% 0 31% 0); animation: gp3 var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-4 { clip-path: inset(82% 0 12% 0); filter: invert(1) hue-rotate(180deg); animation: gp4 var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-cy, .gp-mg { opacity: 0; mix-blend-mode: screen; }
  .gp-cy { filter: sepia(1) hue-rotate(150deg) saturate(6) brightness(1.1); animation: gpCy var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-mg { filter: sepia(1) hue-rotate(280deg) saturate(6) brightness(1.1); animation: gpMg var(--gp-t) steps(1, end) infinite, about-pulse 12s ease-in-out infinite; }
  .gp-line { position: absolute; left: 0; right: 0; top: 0; height: 3px; background: var(--lime); opacity: 0; animation: gpLine var(--gp-t) steps(1, end) infinite; }
  /* rajada menor em 38-42% e principal em 80-92% */
  @keyframes gp1 { 0%, 38%, 43%, 80%, 93%, 100% { translate: 0 0; opacity: 0; } 39% { translate: -14px 0; opacity: 1; } 41% { translate: 9px 0; opacity: 1; } 81% { translate: -30px 0; opacity: 1; clip-path: inset(10% 0 78% 0); } 85% { translate: 22px 0; opacity: 1; clip-path: inset(14% 0 79% 0); } 89% { translate: -12px 0; opacity: 1; } }
  @keyframes gp2 { 0%, 40%, 80%, 94%, 100% { translate: 0 0; opacity: 0; } 82% { translate: 34px 0; opacity: 1; clip-path: inset(36% 0 52% 0); } 84% { translate: -26px 0; opacity: 1; clip-path: inset(40% 0 52% 0); } 87% { translate: 16px 0; opacity: 1; } 90% { translate: -38px 0; opacity: 1; clip-path: inset(37% 0 55% 0); } }
  @keyframes gp3 { 0%, 39%, 44%, 82%, 95%, 100% { translate: 0 0; opacity: 0; } 40% { translate: 12px 0; opacity: 1; } 42% { translate: -8px 0; opacity: 1; } 83% { translate: -22px 0; opacity: 1; } 86% { translate: 30px 0; opacity: 1; clip-path: inset(58% 0 33% 0); } 91% { translate: -16px 0; opacity: 1; clip-path: inset(63% 0 28% 0); } }
  @keyframes gp4 { 0%, 84%, 92%, 100% { translate: 0 0; opacity: 0; } 85% { translate: 18px 0; opacity: .9; } 87% { translate: -28px 0; opacity: .9; clip-path: inset(80% 0 14% 0); } 89% { translate: 10px 0; opacity: .9; } }
  @keyframes gpCy { 0%, 38%, 42%, 80%, 93%, 100% { translate: 0 0; opacity: 0; } 39% { translate: -6px 0; opacity: .7; } 81%, 85%, 89% { translate: -10px 0; opacity: .75; } 83%, 87% { translate: -4px 0; opacity: .5; } }
  @keyframes gpMg { 0%, 38%, 42%, 80%, 93%, 100% { translate: 0 0; opacity: 0; } 39% { translate: 6px 0; opacity: .7; } 81%, 85%, 89% { translate: 10px 0; opacity: .75; } 83%, 87% { translate: 4px 0; opacity: .5; } }
  @keyframes gpLine { 0%, 40%, 42%, 82%, 92%, 100% { opacity: 0; } 41% { opacity: 1; top: 34%; } 83% { opacity: 1; top: 22%; } 86% { opacity: 1; top: 57%; } 89% { opacity: 1; top: 78%; } 91% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .gp { display: none; } }
</style>
