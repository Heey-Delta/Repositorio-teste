---
import Media from './Media.astro';
import GlitchPortrait from './GlitchPortrait.astro';
---
<section id="about" class="border-b border-line bg-surface" aria-label="Filosofia">
  <div class="mx-auto grid min-h-[340px] max-w-[1440px] grid-cols-[1.25fr_0.75fr] lg:min-h-[540px] lg:grid-cols-[0.9fr_1.35fr_0.4fr]">
    <div class="order-1 flex flex-col justify-center gap-5 py-8 pr-4 pl-5 lg:order-2 lg:gap-7 lg:px-[72px] lg:py-20">
      <h2 class="font-ui text-[clamp(28px,8vw,34px)] leading-[1.1] font-medium lg:text-[clamp(44px,3.6vw,52px)]">Design não é<br>decoração.<br>É <span class="text-lime">comunicação.</span></h2>
      <p class="max-w-[360px] text-[13px] text-muted lg:text-[15px]">Todo projeto começa com uma ideia, mas termina com um propósito: conectar, inspirar e resolver.</p>
      <a href="#process" class="label-ui self-start border border-ink px-4 py-2.5 text-[11px] hover:border-lime hover:text-lime lg:px-[22px] lg:py-3 lg:text-xs">Saiba mais →</a>
    </div>
    <div class="relative order-2 border-l border-line lg:order-1 lg:border-r lg:border-l-0">
      <Media label="Retrato" alt="Escultura líquida cromada" src="img/retrato-cromo.webp" class="absolute inset-0" imgClass="about-pulse object-[75%_bottom]"><GlitchPortrait src="img/retrato-cromo.webp" position="75% bottom" /></Media>
      <span class="font-display absolute top-0 right-0 grid size-[72px] place-items-center bg-lime text-[40px] text-black lg:hidden" aria-hidden="true">01</span>
    </div>
    <div class="order-3 hidden flex-col justify-between border-l border-line px-7 py-10 lg:flex">
      <span class="font-display text-[120px] leading-none text-line" aria-hidden="true">01</span>
      <span class="label-ui text-[11px] text-muted">Minha<br>filosofia</span>
    </div>
  </div>
</section>
<style is:global>
  /* Respiração suave: um pequeno zoom (2%) e, em seguida, mais 0,5% */
  .about-pulse { transform-origin: 70% 100%; animation: about-pulse 12s ease-in-out infinite; }
  @keyframes about-pulse {
    0%, 100% { transform: scale(1); }
    35%      { transform: scale(1.02); }
    60%      { transform: scale(1.025); }
    85%      { transform: scale(1.005); }
  }
  @media (prefers-reduced-motion: reduce) { .about-pulse { animation: none; } }
</style>
