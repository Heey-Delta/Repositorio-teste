---
import Media from './Media.astro';
---
<section id="about" class="border-b border-line bg-surface" aria-label="Philosophy">
  <div class="mx-auto grid min-h-[340px] max-w-[1440px] grid-cols-[1.25fr_0.75fr] lg:min-h-[540px] lg:grid-cols-[0.9fr_1.35fr_0.4fr]">
    <div class="order-1 flex flex-col justify-center gap-5 py-8 pr-4 pl-5 lg:order-2 lg:gap-7 lg:px-[72px] lg:py-20">
      <h2 class="font-ui text-[clamp(28px,8vw,34px)] leading-[1.1] font-medium lg:text-[clamp(44px,3.6vw,52px)]">Design is<br>not decoration.<br>It’s <span class="text-lime">communication.</span></h2>
      <p class="max-w-[360px] text-[13px] text-muted lg:text-[15px]">Every project starts with an idea, but it ends with a purpose: to connect, inspire and solve.</p>
      <a href="#process" class="label-ui self-start border border-ink px-4 py-2.5 text-[11px] hover:border-lime hover:text-lime lg:px-[22px] lg:py-3 lg:text-xs">Learn more →</a>
    </div>
    <div class="relative order-2 border-l border-line lg:order-1 lg:border-r lg:border-l-0">
      <Media label="Portrait" class="absolute inset-0" />
      <span class="font-display absolute top-0 right-0 grid size-[72px] place-items-center bg-lime text-[40px] text-black lg:hidden" aria-hidden="true">01</span>
    </div>
    <div class="order-3 hidden flex-col justify-between border-l border-line px-7 py-10 lg:flex">
      <span class="font-display text-[120px] leading-none text-line" aria-hidden="true">01</span>
      <span class="label-ui text-[11px] text-muted">My<br>philosophy</span>
    </div>
  </div>
</section>
