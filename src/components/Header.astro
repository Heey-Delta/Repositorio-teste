---
import Button from './Button.astro';
import DevPanel from './DevPanel.astro';
import Brand from './Brand.astro';
const links = [['#sobre', 'Sobre'], ['#projetos', 'Projetos'], ['#servicos', 'Serviços'], ['#processo', 'Processo'], ['#stacks', 'Stacks'], ['#blog', 'Blog']];
---
<header class="sticky top-[env(safe-area-inset-top,0px)] z-50 border-b border-line bg-paper">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-[18px]">
    <Brand />
    <nav class="flex flex-wrap items-center gap-x-[22px] gap-y-2 text-[15px]" aria-label="Principal">
      {links.map(([href, label]) => <a href={href} class="text-ink-soft no-underline hover:text-ink">{label}</a>)}
      <Button href="#contato" class="min-h-11! px-[18px]!">Fale comigo</Button>
    </nav>
    <DevPanel />
  </div>
</header>
<script is:inline>
  // Altura do cabeçalho fixo em --header-h: o html usa como scroll-padding-top, então as âncoras não ficam escondidas atrás dele
  (function () {
    var header = document.querySelector('body > header');
    if (!header) return;
    function setH() { document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px'); }
    setH();
    if (window.ResizeObserver) new ResizeObserver(setH).observe(header); else window.addEventListener('resize', setH);
  })();
</script>
