---
const links = [['#works', 'Trabalhos'], ['#lab', 'Laboratório'], ['#stacks', 'Stacks & Cursos'], ['#about', 'Sobre'], ['#services', 'Serviços'], ['#process', 'Processo'], ['#contact', 'Contato']];
---
<header class="sticky top-[env(safe-area-inset-top,0px)] z-50 border-b border-line">
  <!-- fundo do cabeçalho: vidro "falso" (quase opaco, com um brilho leve), sem desfoque real, que pesa a cada rolagem -->
  <div class="glass-bar absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="wrap flex h-16 items-center justify-between gap-3 xl:grid xl:h-[72px] xl:grid-cols-[1fr_auto_1fr] xl:gap-6">
    <a href="#top" class="font-display text-[28px] leading-none lg:text-[30px]" aria-label="/HALLAN, voltar ao topo">/HALLAN</a>
    <nav class="hidden gap-6 xl:flex 2xl:gap-9" aria-label="Principal">
      {links.map(([href, label]) => <a href={href} class="label-ui whitespace-nowrap text-ink hover:text-accent">{label}</a>)}
    </nav>
    <div class="flex items-center xl:justify-self-end">
      <button type="button" id="menuBtn" class="menu-btn grid size-11 cursor-pointer place-items-center xl:hidden" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobileNav">
        <svg width="24" height="16" viewBox="0 0 24 16" aria-hidden="true"><path class="mb-1" d="M0 1h24" /><path class="mb-2" d="M0 8h24" /><path class="mb-3" d="M0 15h24" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobileNav" class="glass-nav absolute inset-x-0 top-full hidden xl:hidden!" aria-label="Menu móvel">
    <div class="wrap grid py-2">
      {links.map(([href, label]) => <a href={href} class="label-ui border-b border-white/10 py-4 text-[13px] hover:text-accent last:border-b-0">{label}</a>)}
    </div>
  </nav>
</header>
<script is:inline>
  (function () {
    var header = document.querySelector('body > header'), btn = document.getElementById('menuBtn'), nav = document.getElementById('mobileNav');
    if (!header) return;
    // Altura do cabeçalho em --header-h: o html usa como scroll-padding-top, então as âncoras não ficam atrás dele
    function setH() { document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px'); }
    setH();
    if (window.ResizeObserver) new ResizeObserver(setH).observe(header); else window.addEventListener('resize', setH);
    function toggle(open) { nav.classList.toggle('hidden', !open); btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu'); }
    btn.addEventListener('click', function () { toggle(btn.getAttribute('aria-expanded') !== 'true'); });
    nav.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('a')) toggle(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') toggle(false); });
    // toque fora do menu (e fora do cabeçalho) fecha
    document.addEventListener('pointerdown', function (e) { if (!nav.classList.contains('hidden') && !header.contains(e.target)) toggle(false); });
  })();
</script>
<style is:global>
  /* Vidro "falso": em vez de desfocar o que está atrás (backdrop-filter, caro), um fundo escuro quase opaco com um
     brilho em gradiente e bordas claras. O visual lembra o vidro fosco e o custo é o de uma cor comum. */
  .glass-bar { background: linear-gradient(180deg, rgb(255 255 255 / .035), rgb(255 255 255 / 0) 70%), rgb(0 0 0 / .9); }
  .glass-nav {
    background: linear-gradient(180deg, rgb(255 255 255 / .1), rgb(255 255 255 / .03) 40%, rgb(255 255 255 / .015)), rgb(14 14 14 / .93);
    border-top: 1px solid rgb(255 255 255 / .14); border-bottom: 1px solid rgb(255 255 255 / .08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .06), 0 24px 48px -12px rgb(0 0 0 / .6);
  }
  .glass-nav:not(.hidden) { animation: glassIn .28s cubic-bezier(.2, .8, .2, 1); }
  @keyframes glassIn { from { opacity: 0; transform: translateY(-8px); } }
  /* botão do menu: as três linhas viram um X quando o menu abre */
  .menu-btn path { stroke: currentColor; stroke-width: 2; transform-box: fill-box; transform-origin: center; transition: transform .25s cubic-bezier(.2, .8, .2, 1), opacity .15s; }
  .menu-btn[aria-expanded="true"] .mb-1 { transform: translateY(7px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .mb-2 { opacity: 0; }
  .menu-btn[aria-expanded="true"] .mb-3 { transform: translateY(-7px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) { .glass-nav:not(.hidden) { animation: none; } .menu-btn path { transition: none; } }
</style>
