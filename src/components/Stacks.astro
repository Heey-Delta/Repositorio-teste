---
import SectionHead from './SectionHead.astro';
import { stacks } from '../data/stacks';
---
<section id="stacks" class="section-y" aria-labelledby="stacks-title">
  <div class="wrap">
    <SectionHead eyebrow="Stacks" title="Tecnologias que eu uso" id="stacks-title" text="Ferramentas com as quais eu trabalho no dia a dia." class="mb-10" />
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-10 gap-y-8">
      {stacks.map(({ group, items }) => (
        <div class="grid content-start gap-3">
          <h3 class="eyebrow">{group}</h3>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {items.map((item) => <li class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-[15px] leading-[1.4]">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
