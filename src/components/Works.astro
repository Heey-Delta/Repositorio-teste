---
// Trabalhos. Destaque: a Nexus, cidade isométrica 3D (widget obrigatório, ver widgets.json). Ao lado, os três sites que
// moram nela (pizzaria, cafeteria e restaurante), com a captura real de cada um (public/img/work-*.webp) e link para o site.
// No celular os 4 cards viram um carrossel; no desktop, a Nexus ocupa 2/3 e os três sites ficam empilhados à direita.
// O card dos prédios abre por cima da seção de baixo (CityCard), preso à borda inferior desta seção (por isso `relative z-30`).
import CityCard from './CityCard.astro';
const sites = [
  { title: 'Pizzaria Lourenzo', kind: 'Cardápio e pedido pelo WhatsApp', href: 'widgets/cidade-isometrica/pizzaria/', img: 'img/work-pizzaria.webp', alt: 'Página inicial da pizzaria: título “A margherita do jeito que o pai ensinou” e a pizzaria em 3D' },
  { title: 'Un buon caffè', kind: 'Cafeteria italiana', href: 'widgets/cidade-isometrica/cafeteria/', img: 'img/work-cafeteria.webp', alt: 'Página inicial da cafeteria: título “O café como se toma na Itália” e a cafeteria em 3D' },
  { title: 'Kaoru Kaze', kind: 'Restaurante japonês com reservas', href: 'widgets/cidade-isometrica/restaurante/', img: 'img/work-restaurante.webp', alt: 'Página inicial do restaurante japonês Kaoru Kaze, escura, com o logo em dourado' },
];
---
<section id="works" class="relative z-30 border-b border-line" aria-labelledby="works-title">
  <div class="wrap flex flex-col gap-5 py-8 lg:gap-10 lg:py-16">
    <div class="flex items-end justify-between gap-6">
      <h2 id="works-title" class="font-display text-[clamp(32px,9vw,56px)] leading-none uppercase lg:text-[72px]">/ Trabalhos</h2>
      <p class="hidden max-w-[300px] text-[15px] text-muted lg:block">Uma cidade 3D interativa e os três sites que moram nela. Clique num prédio para abrir o site.</p>
      <div class="flex gap-1 lg:hidden">
        <button type="button" id="worksPrev" class="size-11 cursor-pointer border border-ink text-lg hover:border-lime hover:text-lime" aria-label="Projeto anterior">←</button>
        <button type="button" id="worksNext" class="size-11 cursor-pointer border border-ink text-lg hover:border-lime hover:text-lime" aria-label="Próximo projeto">→</button>
      </div>
    </div>
    <p id="worksCount" class="label-ui tabular-nums lg:hidden" aria-live="polite">01 — 04</p>

    <div id="worksTrack" class="-mx-5 flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto px-5 pb-1 lg:mx-0 lg:grid lg:grid-cols-[2fr_1fr] lg:gap-6 lg:overflow-visible lg:p-0">
      <!-- NEXUS: a cidade isométrica (destaque) -->
      <article class="works-card relative min-h-[460px] min-w-[88%] shrink-0 snap-start overflow-hidden rounded-3xl border border-line bg-surface sm:min-w-[70%] lg:min-h-[660px] lg:min-w-0">
        <!-- fundo da cidade: degradê suave na cor de destaque do site (muda com o tempo); mais forte embaixo, some até o topo -->
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--lime)_30%,transparent),color-mix(in_oklab,var(--lime)_10%,transparent)_45%,transparent_85%)]" aria-hidden="true"></div>
        <iframe class="absolute inset-0 block size-full border-0 bg-transparent [color-scheme:light]" id="cityFrame" src="widgets/cidade-isometrica/index.html?hold=1&card=out" title="Cidade isométrica 3D interativa com os projetos: pizzaria, cafeteria, restaurante japonês, um lote vago e um parque"></iframe>
        <div class="pointer-events-none absolute bottom-0 left-0">
          <div class="pointer-events-auto flex flex-col gap-1.5 rounded-tr-3xl border-t border-r border-line bg-bg/90 p-4 lg:p-6">
            <h3 class="font-display text-[28px] leading-none uppercase lg:text-[44px]">Nexus</h3>
            <p class="label-ui text-[11px] text-muted lg:text-xs">Cidade 3D interativa · 2026</p>
            <a href="widgets/cidade-isometrica/index.html" class="link-ui mt-1.5 self-start text-[11px] lg:text-xs">Abrir em tela cheia →</a>
          </div>
        </div>
      </article>
      <!-- os três sites da cidade -->
      <div class="contents lg:grid lg:grid-rows-3 lg:gap-6">
        {sites.map((w) => (
          <a href={w.href} class="works-card group flex min-h-[460px] min-w-[88%] shrink-0 snap-start flex-col overflow-hidden rounded-3xl border border-line hover:border-lime sm:min-w-[70%] lg:min-h-0 lg:min-w-0">
            <span class="relative block min-h-0 flex-1 overflow-hidden border-b border-line bg-[#111]">
              <img src={w.img} alt={w.alt} width="960" height="600" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-left-top transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none" />
            </span>
            <span class="flex items-end justify-between gap-3 p-4 lg:px-5 lg:py-4">
              <span class="flex min-w-0 flex-col gap-1">
                <span class="font-display text-[26px] leading-none uppercase lg:text-[22px]">{w.title}</span>
                <span class="text-[13px] text-muted">{w.kind}</span>
              </span>
              <span class="label-ui shrink-0 text-[11px] text-lime transition-transform group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">Ver site →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
  <CityCard />
</section>
<script is:inline>
  // Carrossel do celular: setas e contador (no desktop os cards ficam numa grade e nada disso é usado)
  (function () {
    var track = document.getElementById('worksTrack'), count = document.getElementById('worksCount');
    var prev = document.getElementById('worksPrev'), next = document.getElementById('worksNext');
    if (!track) return;
    var cards = track.querySelectorAll('.works-card');
    function step() { return cards[0].getBoundingClientRect().width + 16; }
    function update() {
      var i = Math.min(cards.length - 1, Math.round(track.scrollLeft / step()));
      count.textContent = '0' + (i + 1) + ' — 0' + cards.length;
    }
    track.addEventListener('scroll', update, { passive: true });
    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  })();
</script>
