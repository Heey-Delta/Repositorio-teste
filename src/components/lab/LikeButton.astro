---
// Botão de curtir (raio + contagem: o "hype"). Curtido, o raio fica azul e preenchido. O estado "curti" e a contagem ao vivo vêm do script do layout do Lab.
interface Props { id: string; count?: number; big?: boolean; title?: string }
const { id, count = 0, big = false, title = '' } = Astro.props;
---
<button type="button" class:list={['like', big && 'like--big']} data-like={id} aria-pressed="false" aria-label={`Curtir${title ? ` "${title}"` : ''}: ${count} ${count === 1 ? 'curtida' : 'curtidas'}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.2 2.5 4.8 13.4h6.1l-1.1 8.1 8.4-10.9h-6.1l1.1-8.1z"/></svg>
  <span data-like-count>{count}</span>{big && <span class="sr-only"> {count === 1 ? 'curtida' : 'curtidas'}</span>}
</button>
