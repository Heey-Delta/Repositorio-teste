---
const services = [
  ['Web Design', 'Layout no Figma, pensado primeiro para o celular.'],
  ['Desenvolvimento Web', 'Código leve, carregamento rápido e SEO básico.'],
  ['Landing Pages', 'Uma página, uma oferta e um botão de contato.'],
  ['E-commerce', 'Loja virtual com catálogo, carrinho e pagamento.'],
  ['Creative Dev', '3D, animações e interações, como a cidade acima.'],
  ['Branding Digital', 'Logo, cores e tipografia aplicados ao site.'],
];
---
<section id="services" class="border-b border-line" aria-labelledby="services-title">
  <div class="wrap flex flex-col gap-5 py-8 lg:grid lg:min-h-[360px] lg:grid-cols-[1fr_2fr] lg:items-start lg:gap-16 lg:py-16">
    <div class="flex flex-col gap-3 lg:gap-5">
      <h2 id="services-title" class="font-display text-[32px] leading-none uppercase lg:text-5xl">/ Serviços</h2>
      <p class="max-w-[300px] text-[13px] text-muted lg:text-[15px]">Design e código feitos pela mesma pessoa, do primeiro rascunho ao site no ar.</p>
    </div>
    <ul class="m-0 grid list-none grid-cols-2 gap-x-5 p-0 lg:gap-x-14">
      {services.map(([name, text]) => (
        <li class="border-b border-line py-3 lg:py-[18px]">
          <h3 class="m-0 text-sm font-bold lg:text-[17px]">{name}</h3>
          <p class="m-0 mt-1 hidden text-[13px] text-muted lg:block">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
