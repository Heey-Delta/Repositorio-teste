---
// Serviços: lista numerada; um clique abre um card com os detalhes (mesmo visual do card das stacks).
const services = [
  { name: 'Web Design', desc: 'Layout das páginas no Figma, pensado primeiro para o celular.', how: 'Começo pela estrutura e pelo texto, aprovo com você e só então desenho o visual final.' },
  { name: 'Desenvolvimento Web', desc: 'O layout vira um site de verdade: leve, rápido e fácil de achar no Google.', how: 'Astro, Tailwind e JavaScript, com o site publicado e pronto para atualizar.' },
  { name: 'Landing Pages', desc: 'Uma página só, com uma oferta clara e um botão de contato.', how: 'Para lançar um produto, um serviço ou uma campanha, com foco em quem chega pelo anúncio.' },
  { name: 'E-commerce', desc: 'Loja virtual com catálogo, carrinho e pagamento.', how: 'Do cadastro dos produtos ao checkout, com a compra pensada para o celular.' },
  { name: 'Creative Dev', desc: '3D, animações e interações que fazem o site ser lembrado.', how: 'Como a cidade isométrica desta página, feita com Three.js.' },
  { name: 'Branding Digital', desc: 'Logo, cores e tipografia aplicados ao site e às redes.', how: 'Cada site da cidade tem identidade visual própria, criada do zero.' },
];
---
<section id="services" class="relative border-b border-line" aria-labelledby="services-title">
  <div class="wrap flex flex-col gap-5 py-8 lg:grid lg:min-h-[360px] lg:grid-cols-[1fr_2fr] lg:items-start lg:gap-16 lg:py-16">
    <div class="flex flex-col gap-3 lg:gap-5">
      <h2 id="services-title" class="font-display text-[32px] leading-none uppercase lg:text-5xl">/ Serviços</h2>
      <p class="max-w-[300px] text-[13px] text-muted lg:text-[15px]">Design e código feitos pela mesma pessoa, do primeiro rascunho ao site no ar.</p>
      <p class="label-ui m-0 text-[11px] text-muted">Clique para ver detalhes</p>
    </div>
    <div>
      <ol class="m-0 grid list-none grid-flow-col grid-cols-2 grid-rows-3 gap-x-5 p-0 lg:gap-x-14">
        {services.map((sv, i) => (
          <li class="border-b border-line">
            <button type="button" class="svc-item group grid w-full cursor-pointer grid-cols-[28px_1fr_auto] items-baseline gap-1.5 py-3 text-left hover:text-lime lg:grid-cols-[56px_1fr_auto] lg:py-[18px]" data-i={i} aria-haspopup="dialog">
              <span class="text-[13px] text-muted tabular-nums lg:text-sm">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-sm lg:text-[17px]">{sv.name}</span>
              <span class="text-muted transition-transform group-hover:rotate-90 group-hover:text-lime motion-reduce:transition-none" aria-hidden="true">+</span>
            </button>
          </li>
        ))}
      </ol>
      <!-- card de detalhes (abre no clique) -->
      <div id="svcCard" class="absolute inset-0 z-20 hidden place-items-center bg-black/80 p-5">
        <div role="dialog" aria-modal="true" aria-labelledby="svcCardTitle" class="svc-pop relative flex w-full max-w-[420px] flex-col gap-3 border border-ink bg-bg p-6">
          <button type="button" id="svcCardClose" class="label-ui absolute top-3 right-3 cursor-pointer px-2 py-1 text-[11px] text-muted hover:text-lime" aria-label="Fechar">Fechar ✕</button>
          <p id="svcCardNum" class="label-ui m-0 text-[11px] text-lime tabular-nums"></p>
          <h3 id="svcCardTitle" class="m-0 font-display text-[32px] leading-none uppercase"></h3>
          <p id="svcCardDesc" class="m-0 text-sm text-muted"></p>
          <p class="m-0 border-t border-line pt-3 text-sm"><span class="label-ui mr-2 text-[11px] text-muted">Como faço</span><span id="svcCardHow"></span></p>
          <a href="#contact" class="link-ui self-start text-[11px]">Pedir orçamento →</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style is:global>
  #svcCard.open { display: grid; }
  #svcCard.open .svc-pop { animation: svc-pop .22s cubic-bezier(.2, .8, .2, 1); }
  @keyframes svc-pop { from { opacity: 0; transform: translateY(6px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { #svcCard.open .svc-pop { animation: none; } }
</style>
<script is:inline define:vars={{ services }}>
  (function () {
    var card = document.getElementById('svcCard'); if (!card) return;
    var opener = null;
    function show(i) {
      var sv = services[i];
      document.getElementById('svcCardNum').textContent = String(i + 1).padStart(2, '0') + ' / ' + String(services.length).padStart(2, '0');
      document.getElementById('svcCardTitle').textContent = sv.name;
      document.getElementById('svcCardDesc').textContent = sv.desc;
      document.getElementById('svcCardHow').textContent = sv.how;
      card.classList.add('open');
      document.getElementById('svcCardClose').focus();
    }
    function hide() {
      if (!card.classList.contains('open')) return;
      card.classList.remove('open');
      if (opener) opener.focus();
    }
    [].forEach.call(document.querySelectorAll('.svc-item'), function (b) {
      b.addEventListener('click', function () { opener = b; show(+b.dataset.i); });
    });
    document.getElementById('svcCardClose').addEventListener('click', hide);
    card.addEventListener('click', function (e) { if (e.target === card) hide(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
  })();
</script>
