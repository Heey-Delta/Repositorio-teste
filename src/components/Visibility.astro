---
// Economia de processamento:
// 1) Cada seção fora da tela recebe data-off, e o CSS pausa todas as animações dela.
// 2) Variável cíclica global --lime-cycle (90s, lime → laranja → azul → lime) sempre roda.
//    Elementos na tela transitam suavemente para essa cor via CSS.
//    Elementos off-screen mantêm sua cor anterior com animações pausadas.
// 3) Throttling melhorado: IntersectionObserver + requestAnimationFrame.
---
<script is:inline>
  (function () {
    var K = [[0.918, 0.235, 127.7], [0.76, 0.16, 55], [0.72, 0.15, -115], [0.918, 0.235, -232.3]];
    var CYCLE = 90000;

    function lerp(a, b, t) { return a + (b - a) * Math.max(0, Math.min(1, t)); }
    function oklch(k, t) {
      if (t <= 0) return k[0];
      var n = K.length, i = Math.floor(t * n) % n, i1 = (i + 1) % n;
      var a = (t * n - i) % 1;
      return [lerp(K[i][0], K[i1][0], a), lerp(K[i][1], K[i1][1], a), lerp(K[i][2], K[i1][2], a)];
    }
    function toOklch(k) {
      return 'oklch(' + k[0].toFixed(3) + ' ' + k[1].toFixed(3) + ' ' + k[2].toFixed(1) + ')';
    }

    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var rafId = null;

    function tick(now) {
      var t = (now % CYCLE) / CYCLE;
      var color = toOklch(oklch(K, t));
      document.documentElement.style.setProperty('--lime-cycle', color);
      if (!reduce) rafId = requestAnimationFrame(tick);
    }

    if (!reduce) {
      tick(performance.now());
    } else {
      // reducedMotion: cor fixa
      document.documentElement.style.setProperty('--lime-cycle', toOklch(K[0]));
    }

    // IntersectionObserver com throttling via requestAnimationFrame
    var ticking = false;
    function scheduleObserverUpdate(fn) {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () { ticking = false; fn(); });
      }
    }

    if (window.IntersectionObserver) {
      var io = new IntersectionObserver(function (en) {
        scheduleObserverUpdate(function () {
          en.forEach(function (e) {
            e.target.setAttribute('data-off', e.isIntersecting ? '' : '1');
          });
        });
      }, { rootMargin: '150px 0px' });

      document.querySelectorAll('main > section, body > footer').forEach(function (s) { io.observe(s); });
    }
  })();
</script>

<style is:global>
  /* Elementos visíveis transitam suavemente para --lime-cycle */
  [class*="lime"]:not([data-off]),
  .link-ui:not([data-off]),
  .accent:not([data-off]) {
    transition: color 0.8s ease-out;
    --lime: var(--lime-cycle);
  }
</style>
