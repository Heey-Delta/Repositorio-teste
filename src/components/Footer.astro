---
import { siGithub, siLinkedin, siX } from 'simple-icons';
const links = [['#works', 'Trabalhos'], ['lab/', 'Laboratório'], ['#about', 'Sobre'], ['#services', 'Serviços'], ['#process', 'Processo'], ['#contact', 'Contato']];
// Redes: preencha o endereço de cada perfil; as que ficarem vazias não aparecem.
const social = [
  { name: 'GitHub', icon: siGithub, href: '' },
  { name: 'LinkedIn', icon: siLinkedin, href: '' },
  { name: 'X', icon: siX, href: '' },
].filter((s) => s.href);
---
<footer class="bg-bg">
  <div class="wrap flex flex-col gap-6 py-7 lg:grid lg:min-h-[120px] lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-6 lg:py-0">
    <div class="flex items-center gap-4 lg:gap-6"><span class="font-display text-[28px] leading-none lg:text-[30px]">/HALLAN</span><span class="text-xs text-muted">Design e código de sites</span></div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] lg:gap-7 lg:text-xs" aria-label="Rodapé">
      {links.map(([href, label]) => <a href={href} class="hover:text-accent">{label}</a>)}
    </nav>
    <div class="flex items-center gap-3 lg:justify-self-end">
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="grid size-11 place-items-center border border-ink hover:border-accent hover:text-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon.path} /></svg>
        </a>
      ))}
      <span class="text-xs text-muted tabular-nums">© 2026 Hallan</span>
    </div>
  </div>
</footer>
