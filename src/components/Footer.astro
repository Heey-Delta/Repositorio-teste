---
const links = [['#works', 'Works'], ['#about', 'About'], ['#services', 'Services'], ['#process', 'Process'], ['#lab', 'Lab'], ['#contact', 'Contact']];
const social = [['GitHub', 'GH'], ['LinkedIn', 'IN'], ['X', 'X']];
---
<footer class="bg-bg">
  <div class="wrap flex flex-col gap-6 py-7 lg:grid lg:min-h-[120px] lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-6 lg:py-0">
    <div class="flex items-center gap-4 lg:gap-6"><span class="font-display text-[28px] leading-none lg:text-[30px]">/DV</span><span class="text-xs text-muted">Digital Experience Designer</span></div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] lg:gap-7 lg:text-xs" aria-label="Footer">
      {links.map(([href, label], i) => <a href={href} class:list={['hover:text-lime', i === 3 || i === 4 ? 'hidden lg:inline' : '']}>{label}</a>)}
    </nav>
    <div class="flex gap-3 lg:hidden">
      {social.map(([name, short]) => <a href="#top" aria-label={name} class="label-ui grid size-11 place-items-center rounded-full border border-ink text-[11px] hover:border-lime hover:text-lime">{short}</a>)}
    </div>
    <p class="m-0 hidden items-center gap-2.5 justify-self-end text-xs text-muted lg:flex">Let’s create something amazing.<span class="size-2 rounded-full bg-lime" aria-hidden="true"></span></p>
  </div>
</footer>
